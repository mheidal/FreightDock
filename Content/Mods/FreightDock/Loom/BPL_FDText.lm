// Adds the strings to the game's English (BP_Startup, once: each call rebuilds every widget in the game). Only "en":
// "dev" would override every language's translation.
fn Register(Api: ModAPI) {
    Api.AddNewStrings("en", Strings())
}

// Key in the player's language; the English here when the game has none (or the key itself, if it isn't here).
pure fn T(Key: name) -> string {
    let word = LocManager.GetWordFromKey(Key)
    if word != "" {
        return word
    }
    let own = Strings().Find(Key)
    return if own.ReturnValue { own.Value } else { string(Key) }
}

// S with "{Slot}" replaced by Value.
pure fn Fill(S: string, Slot: string, Value: string) -> string {
    return KismetStringLibrary.Replace(S, "{" + Slot + "}", Value, ESearchCase.CaseSensitive)
}

// T(Key) with one placeholder filled.
pure fn T1(Key: name, Slot: string, Value: string) -> string {
    return Fill(T(Key), Slot, Value)
}

// T(Key) with two placeholders filled.
pure fn T2(Key: name, Slot1: string, Value1: string, Slot2: string, Value2: string) -> string {
    return Fill(Fill(T(Key), Slot1, Value1), Slot2, Value2)
}
