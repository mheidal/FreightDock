blueprint BPL_FDLoad : BlueprintFunctionLibrary at /Game/Mods/FreightDock/Loom/BPL_FDLoad

// Loading plan for a freight dock with a job (BP_MapLoad.UpdateRequest calls Plan; BPL_FDDispatch gives out jobs):
// what to ask haulers to bring so the job's manifest ends up aboard.
//
// - Per good of the manifest: got = in the hold + being carried here. Haulers carry goods straight into the hold; a
//   count left in the input slot ("at dock" in the log) never boards, so it doesn't count.
//   The request is a total to have aboard: the manifest, or the hold when that is more. RequestFor sets the input
//   slot's capacity to the request less the hold, so haulers beyond it are turned away. Goods not in the manifest
//   leave the request (their slot's capacity goes to 0).
// - Remaining (for departure, "all wanted aboard"): the manifest not yet aboard, waiting or carried.
// - Parked leftovers the job takes (BPL_FDNet.ParkKey) are moved from the dock's delivered-goods store straight into
//   the hold (unreserved units only).
// - Stalled: a good whose manifest isn't met and that no hauler has picked up for Stall() seconds is cut from the
//   manifest down to what is got; the rest goes back to the dispatcher's pool. MapLoad.PickupSeen holds each
//   "<dock>|<good>"'s got at the last plan, MapLoad.PickupSince when it last grew. MapLoad.CutStock records the
//   input warehouses' free stock of the good then; the dispatcher doesn't offer it from this dock until that changes.
// - Anything aboard beyond the manifest is parked (BPL_FDNet.ParkStray), except provisions (canned food), which stay
//   aboard and out of the request.
//   InFlight is the manifest's goods being carried.

pure fn Stall() -> float {
    return 20.0
}

pure fn Key(Id: int, Res: name) -> string {
    return string(Id) + "|" + string(Res)
}

// Moves the parked leftovers the job takes from the dock's delivered-goods store straight into its ship's hold, as
// far as unreserved units allow (the game loads only what haulers carry aboard, never from the input slot).
fn BoardParked(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Ship: NauticalShip, Id: int) {
    let prefix = string(Id) + "|"
    let keys: array<string> = []
    for key, units in MapLoad.JobGoods {
        if units > 0 && KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) && KismetStringLibrary.EndsWith(key, "|park", ESearchCase.CaseSensitive) {
            keys.Add(key)
        }
    }
    for key in keys {
        let res = name(KismetStringLibrary.LeftChop(KismetStringLibrary.RightChop(key, KismetStringLibrary.Len(prefix)), 5))
        let want = MapLoad.JobGoods[key]
        let pile = Dock.m_stockpile_goodsFromSea
        let f = pile.Slots.Find(res)
        let free = if f.ReturnValue { f.Value.count - f.Value.reservedForPickup } else { 0 }
        let move = KismetMathLibrary.Min(want, free)
        if move > 0 {
            let from = f.Value
            from.count = from.count - move
            pile.Slots[res] = from
            Dock.m_stockpile_goodsFromSea = pile
            let state = Ship.State
            let cargo = state.cargo
            let items = cargo.Items
            let had = items.Find(res)
            let item = if had.ReturnValue { had.Value } else { NauticalCargoItem(ItemName: res, Quantity: 0.0) }
            item.Quantity = item.Quantity + float(move)
            items[res] = item
            cargo.Items = items
            state.cargo = cargo
            Ship.State = state
        }
        MapLoad.JobGoods[key] = want - move
    }
}

fn Plan(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Partner: WorkDock, Ship: NauticalShip, NoMore: bool, out Request: map<name, int>, out Remaining: int, out InFlight: int, out Space: int, out Detail: string) {
    if Ship == none || Dock == none {
        return
    }
    let now = GameplayStatics.GetTimeSeconds()
    let id = BPL_FDNet.DockId(Dock)
    BoardParked(MapLoad, Dock, Ship, id)
    // the ship carries only the job's freight: anything else that got aboard goes to the delivered-goods store
    let stray = BPL_FDNet.ParkStray(MapLoad, Dock, BPL_FDNet.Manifest(MapLoad, id))
    if stray != "" {
        ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Dock " + string(id) + ": not the job's freight, parked:" + stray, false)
    }
    let held = MapLoad.HoldCounts(Ship)
    let hold = held.Counts

    for res, units in BPL_FDNet.Manifest(MapLoad, id) {
        let h = hold.Find(res)
        let inHold = if h.ReturnValue { h.Value } else { 0 }
        let f = Dock.m_inputStockpile.Slots.Find(res)
        let carried = if f.ReturnValue { f.Value.reservedSpaceForDropoff } else { 0 }
        let atDock = if f.ReturnValue { f.Value.count } else { 0 }
        let got = inHold + carried
        InFlight += carried

        // stall: no pickup (got growing) for Stall() seconds while the manifest isn't met: cut it to got
        let key = Key(id, res)
        // copied into variables before PickupSeen is written: a map Find is re-read wherever it is used
        let before = -1
        let seen = MapLoad.PickupSeen.Find(key)
        if seen.ReturnValue {
            before = seen.Value
        }
        let since = MapLoad.PickupSince.Find(key)
        let sinceT = if since.ReturnValue { since.Value } else { now }
        if before < 0 || got > before || got >= units {
            sinceT = now
        }
        MapLoad.PickupSeen[key] = got
        MapLoad.PickupSince[key] = sinceT
        let target = units
        let cut = false
        if got < units && now - sinceT > Stall() {
            target = got
            cut = true
            MapLoad.JobGoods[BPL_FDNet.JobKey(id, res)] = got
            MapLoad.PickupSince[key] = now
            // the dispatcher leaves the good with this dock until its input warehouses' free stock changes
            let left = BPL_FDNet.SourceStock(MapLoad, Dock).Stock.Find(res)
            MapLoad.CutStock[BPL_FDNet.JobKey(id, res)] = if left.ReturnValue { left.Value } else { 0 }
        }

        // the manifest, or what is aboard when more (left as it is); what waits in the input slot or is carried
        // doesn't raise it, so hauls don't feed on themselves
        if !NoMore && target > 0 {
            Request[res] = KismetMathLibrary.Max(target, inHold)
        }
        // waiting to leave (NoMore): only what is already on its way stays requested, so those haulers aren't
        // turned away
        if NoMore && carried > 0 {
            Request[res] = inHold + carried
        }
        if !NoMore {
            Remaining += KismetMathLibrary.Max(target - got, 0)
        }
        Detail += string(res) + ": " + string(got) + " of " + string(target) + " (at dock " + string(atDock) + ", in flight " + string(carried) + (if cut { ", cut: stalled" } else { "" }) + "); "
    }
    Space = 0
    if !NoMore {
        Space = KismetMathLibrary.Max(Ship.config.cargoLimit - held.Total - InFlight, 0)
    }
}

// Writes Want as the dock's request: its dock-specific supplies and live requirement, and per good its input slot's
// capacity, the request less what is in the hold (never the whole request: haulers would be sent for goods already
// aboard). A good that left the request leaves the live requirement, and its input slot's capacity goes to 0.
fn RequestFor(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Want: ResourceCollection) {
    let old = Dock.m_requiredEmbarkSupplies_dockSpecific.counts
    Dock.m_requiredEmbarkSupplies_dockSpecific = Want
    let ship = BPL_FDNet.ShipAtDock(MapLoad, Dock)
    let hold: map<name, int> = {}
    if ship != none {
        hold = MapLoad.HoldCounts(ship).Counts
    }
    let live = Dock.m_requiredEmbarkSupplies_live
    let pile = Dock.m_inputStockpile
    for res, was in old {
        if !Want.counts.Contains(res) {
            live.counts.Remove(res)
            let f = pile.Slots.Find(res)
            if f.ReturnValue {
                let gone = f.Value
                gone.capacity = 0
                pile.Slots[res] = gone
            }
        }
    }
    for res, units in Want.counts {
        live.counts[res] = units
        let h = hold.Find(res)
        let room = KismetMathLibrary.Max(units - (if h.ReturnValue { h.Value } else { 0 }), 0)
        let g = pile.Slots.Find(res)
        let slot = if g.ReturnValue { g.Value } else { ResourceStockpileSlot(count: 0, capacity: 0) }
        slot.capacity = room
        pile.Slots[res] = slot
    }
    Dock.m_requiredEmbarkSupplies_live = live
    Dock.m_inputStockpile = pile
}

// The panel's Deliver now button (BP_MapLoad.DeliverSelected, ported from fdgen): the selected freight dock's ship sails
// now with what it has - its loading clock (LoadingSince) is set far back so FreightTick's max-wait check passes. Ship
// away or nothing loaded yet: a toast.
fn DeliverSelected(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    let dock = MapLoad.FindDockUnderCursor().Dock
    if dock == none {
        return
    }
    let id = BPL_FDNet.DockId(dock)
    if MapLoad.Voyages.Contains(id) {
        MapLoad.Toast(BPL_FDText.T("freightdock.toast.underWay"))
        return
    }
    if !MapLoad.LoadingSince.Contains(id) {
        MapLoad.Toast(BPL_FDText.T("freightdock.toast.nothingLoaded"))
        return
    }
    MapLoad.LoadingSince[id] = -1000000000000000.0
    ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Deliver now: dock " + string(id), false)
}
