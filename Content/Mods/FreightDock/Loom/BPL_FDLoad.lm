blueprint BPL_FDLoad : BlueprintFunctionLibrary at /Game/Mods/FreightDock/Loom/BPL_FDLoad

// Loading plan for a freight dock with a job (BP_MapLoad.UpdateRequest calls Plan; BPL_FDDispatch gives out jobs):
// what to ask haulers to bring so the job's manifest ends up aboard.
//
// - Per good of the manifest: got = in the hold + being carried here. Haulers carry goods straight into the hold; the
//   input slot's count ("at dock" in the log) is the game's bookkeeping for hauls under way, not goods, so it doesn't
//   count (BPL_FDNet.ClearInputCounts zeroes it when stale).
//   The request is a total to have aboard: the manifest, or the hold when that is more. RequestFor sets the input
//   slot's capacity to the request less the hold, so haulers beyond it are turned away. Goods not in the manifest
//   leave the request (their slot's capacity goes to 0).
// - Remaining (for departure, "all wanted aboard"): the manifest not yet aboard, waiting or carried.
// - Parked leftovers the job takes (BPL_FDNet.ParkKey) are moved from the dock's delivered-goods store straight into
//   the hold (unreserved units only).
// - Stalled: a good whose manifest isn't met is cut from the manifest down to what is got once nothing of the job
//   has moved for Stall() seconds: no good gained and none being carried (haulers fetch one good after another, so
//   a good waiting its turn isn't stalled). The rest goes back to the dispatcher's pool. MapLoad.PickupSeen holds each
//   "<dock>|<good>"'s got at the last plan, MapLoad.PickupSince when it last grew. MapLoad.CutStock records the
//   input warehouses' free stock of the good then; the dispatcher doesn't offer it from this dock until that changes.
// - Anything aboard beyond the manifest is parked (BPL_FDNet.ParkStray), except provisions (canned food), which stay
//   aboard and out of the request.
//   InFlight is the manifest's goods being carried.

// Once per load (BPL_FDPairing.Tick, every frame until done), when the buildings are indexed and the load's route scan
// is done: the jobs kept in the colony's event flags (BPL_FDNet.JobEntry, "j<provider>") and the demand ages
// ("a<requester>") come back (RestoreJob), entries that no longer apply go (Cleanup), and the dispatcher, FreightTick
// and BPL_FDNet.SaveJobs start (JobsRestored).
fn RestoreJobs(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    if MapLoad.JobsRestored {
        return
    }
    if MapLoad.IndexedAt <= 0.0 || MapLoad.ScanPhase != 0 || MapLoad.Blocked.Length() == 0 {
        return
    }
    if ArcoSystems.GetArcoSys().ReturnValue == none {
        return
    }
    MapLoad.JobsRestored = true
    let now = BPL_FDNet.ColonyTime()
    let loading = 0
    let sailing = 0
    let dropped = 0
    for key, value in BPL_FDStore.Entries(MapLoad) {
        let pid = BPL_FDNet.EntryId(key, "j")
        if pid > 0 {
            let kind = RestoreJob(MapLoad, pid, value, now)
            if kind == 1 {
                loading += 1
            } else if kind == 2 {
                sailing += 1
            } else {
                dropped += 1
                BPL_FDStore.Set(MapLoad, key, "")
            }
        }
        let rid = BPL_FDNet.EntryId(key, "a")
        if rid > 0 {
            for age in KismetStringLibrary.ParseIntoArray(value, ",", true) {
                let ap = KismetStringLibrary.ParseIntoArray(age, ":", true)
                if ap.Length() >= 2 {
                    MapLoad.DemandSince[BPL_FDNet.JobKey(rid, name(ap[0]))] = KismetStringLibrary.Conv_StringToDouble(ap[1])
                }
            }
        }
    }
    let removed = Cleanup(MapLoad)
    ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Jobs restored: " + string(loading) + " loading, " + string(sailing) + " sailing, " + string(dropped) + " dropped; " + string(removed) + " stale name(s) removed", false)
    // the docks' requests at once: a save brings their input slots back without capacity, and the game turns away
    // haulers already carrying goods to a slot without room
    FreightTick(MapLoad)
}

// Job Pid from its entry (BPL_FDNet.JobEntry): 1 loading, 2 sailing, 0 dropped (wrong format, or its dock, ship or
// requester is gone). A sailing job sails on: its voyage starts again (BP_MapLoad.StartVoyage) and the stand-in is put
// where the colony clock says - outbound, the distance sailed since departure, while the manifest's goods are still
// aboard (no goods aboard: it has delivered, and waits at the requester); at the requester until the end of the
// dwell; homeward, the distance sailed since the dwell ended.
fn RestoreJob(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Pid: int, Value: string, Now: float) -> int {
    let f = KismetStringLibrary.ParseIntoArray(Value, ";", false)
    if f.Length() < 9 {
        return 0
    }
    if f[0] != BPL_FDNet.JobFormat() {
        return 0
    }
    let rid = KismetStringLibrary.Conv_StringToInt(f[1])
    let dock = BPL_FDNet.DockIn(MapLoad, Pid)
    let target = BPL_FDNet.DockIn(MapLoad, rid)
    if dock == none || target == none {
        return 0
    }
    let ship = BPL_FDNet.ShipAtDock(MapLoad, dock)
    if ship == none {
        return 0
    }
    MapLoad.JobTo[Pid] = rid
    for g in KismetStringLibrary.ParseIntoArray(f[8], ",", true) {
        let gp = KismetStringLibrary.ParseIntoArray(g, ":", true)
        if gp.Length() >= 3 {
            let res = name(gp[0])
            MapLoad.JobGoods[BPL_FDNet.JobKey(Pid, res)] = KismetStringLibrary.Conv_StringToInt(gp[1])
            let parked = KismetStringLibrary.Conv_StringToInt(gp[2])
            if parked > 0 {
                MapLoad.JobGoods[BPL_FDNet.ParkKey(Pid, res)] = parked
            }
        }
    }
    if f[2] != "" {
        MapLoad.LoadingSince[Pid] = KismetStringLibrary.Conv_StringToDouble(f[2])
    }
    if f[3] != "" {
        MapLoad.DepartingSince[Pid] = KismetStringLibrary.Conv_StringToDouble(f[3])
    }
    if f[5] == "m" {
        MapLoad.ManualDepart[Pid] = true
    }
    if f.Length() > 9 {
        let note = f[9]
        if note != "" {
            // "s:" / "t:" back to capitals, "-" back to "/"
            MapLoad.JobShort[Pid] = KismetStringLibrary.Replace(KismetStringLibrary.ToUpper(KismetStringLibrary.Left(note, 1)) + KismetStringLibrary.RightChop(note, 1), "-", "/", ESearchCase.CaseSensitive)
        }
    }
    if f.Length() > 10 {
        if f[10] != "" {
            MapLoad.JobDropped[Pid] = f[10]
        }
    }
    if f[4] == "" {
        BPL_FDNet.SlotProbe(MapLoad, dock, "restore")
        return 1
    }
    let departed = KismetStringLibrary.Conv_StringToDouble(f[4])
    MapLoad.DepartedAt[Pid] = departed
    let phase = if f[6] == "" { 1 } else { KismetStringLibrary.Conv_StringToInt(f[6]) }
    let waitEnd = if f[7] == "" { Now + MapLoad.DwellSeconds } else { KismetStringLibrary.Conv_StringToDouble(f[7]) }
    if phase <= 1 {
        // outbound: delivered already when none of the manifest is aboard any more
        let hold = MapLoad.HoldCounts(ship).Counts
        let aboard = false
        for mres, munits in BPL_FDNet.Manifest(MapLoad, Pid) {
            if hold.Find(mres).Value > 0 {
                aboard = true
            }
        }
        if !aboard {
            phase = 2
            waitEnd = Now + MapLoad.DwellSeconds
        }
    }
    MapLoad.StartVoyage(dock, target, ship)
    // no stand-in (a timed trip): FreightTick delivers TripSeconds after DepartedAt
    if !MapLoad.Voyages.Contains(Pid) {
        return 2
    }
    let spline = MapLoad.VoyageSpline.Find(Pid).Value
    if !KismetSystemLibrary.IsValid(spline) {
        return 2
    }
    let len = spline.GetSplineLength()
    if phase <= 1 {
        MapLoad.VoyageDist[Pid] = KismetMathLibrary.FMin(KismetMathLibrary.FMax(Now - departed, 0.0) * MapLoad.ShipSpeed, len)
    } else if phase == 2 {
        MapLoad.VoyagePhase[Pid] = 2
        MapLoad.VoyageDist[Pid] = len
        MapLoad.VoyageWait[Pid] = waitEnd
    } else {
        MapLoad.VoyagePhase[Pid] = 3
        MapLoad.VoyageWait[Pid] = waitEnd
        spline.K2_DestroyComponent()
        let home = MapLoad.MakeCourse(Pid, ship, true).Course
        MapLoad.VoyageSpline[Pid] = home
        let homeLen = if KismetSystemLibrary.IsValid(home) { home.GetSplineLength() } else { 0.0 }
        MapLoad.VoyageDist[Pid] = KismetMathLibrary.FMin(KismetMathLibrary.FMax(Now - waitEnd, 0.0) * MapLoad.ShipSpeed, homeLen)
    }
    BPL_FDVoyage.PlaceStandIn(MapLoad, Pid)
    return 2
}

// After the restore: names of docks whose building is gone ("d<id>") are removed; network names stay (a network keeps
// its name with no members), and keys of other kinds are left alone. Returns how many went.
fn Cleanup(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> int {
    let removed = 0
    for key, value in BPL_FDStore.Entries(MapLoad) {
        let did = BPL_FDNet.EntryId(key, "d")
        if did > 0 {
            if BPL_FDNet.BuildingById(MapLoad, did) == none {
                BPL_FDStore.Set(MapLoad, key, "")
                removed += 1
            }
        }
    }
    return removed
}

pure fn Stall() -> float {
    return 20.0
}

pure fn Key(Id: int, Res: name) -> string {
    return string(Id) + "|" + string(Res)
}

// Moves the parked leftovers the job takes from the dock's delivered-goods store straight into its ship's hold, as
// far as unreserved units allow (the game loads only what haulers carry aboard, never from the input slot).
fn BoardParked(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Ship: NauticalShip, Id: int) {
    let prefix = string(Id) + "|"
    let keys: array<string> = []
    for key, units in MapLoad.JobGoods {
        if units > 0 && KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) && KismetStringLibrary.EndsWith(key, "|park", ESearchCase.CaseSensitive) {
            keys.Add(key)
        }
    }
    for key in keys {
        let res = name(KismetStringLibrary.LeftChop(KismetStringLibrary.RightChop(key, KismetStringLibrary.Len(prefix)), 5))
        let want = MapLoad.JobGoods[key]
        let pile = Dock.m_stockpile_goodsFromSea
        let f = pile.Slots.Find(res)
        let free = if f.ReturnValue { f.Value.count - f.Value.reservedForPickup } else { 0 }
        let move = KismetMathLibrary.Min(want, free)
        BPL_FDDispatch.Probe(MapLoad, "Probe: job " + string(Id) + " boards parked " + string(res) + ": wants " + string(want) + ", store free " + string(free) + ", moved " + string(KismetMathLibrary.Max(move, 0)))
        if move > 0 {
            let from = f.Value
            from.count = from.count - move
            pile.Slots[res] = from
            Dock.m_stockpile_goodsFromSea = pile
            let state = Ship.State
            let cargo = state.cargo
            let items = cargo.Items
            let had = items.Find(res)
            let item = if had.ReturnValue { had.Value } else { NauticalCargoItem(ItemName: res, Quantity: 0.0) }
            item.Quantity = item.Quantity + float(move)
            items[res] = item
            cargo.Items = items
            state.cargo = cargo
            Ship.State = state
        }
        MapLoad.JobGoods[key] = want - move
    }
}

// Target (the job's requester) isn't read here: the manifest already says what it gets.
fn Plan(MapLoad:/Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Target: WorkDock, Ship: NauticalShip, NoMore: bool, out Request: map<name, int>, out Remaining: int, out InFlight: int, out Space: int, out Detail: string) {
    if Ship == none || Dock == none {
        return
    }
    let now = BPL_FDNet.ColonyTime()
    let id = BPL_FDNet.DockId(Dock)
    // back from its voyage, waiting for the dispatcher to close the job (BPL_FDDispatch.Complete): nothing is
    // requested or checked for a stall (its goods were delivered, not lost: a stall cut would drop them and bar the
    // good from this dock), and Remaining 1 keeps it from sailing again
    let sailed = MapLoad.JobSailed.Find(id)
    if sailed.ReturnValue && sailed.Value {
        Remaining = 1
        return
    }
    BoardParked(MapLoad, Dock, Ship, id)
    // the ship carries only the job's freight: anything else that got aboard goes to the delivered-goods store
    BPL_FDNet.ParkStray(MapLoad, Dock, BPL_FDNet.Manifest(MapLoad, id))
    let held = MapLoad.HoldCounts(Ship)
    let hold = held.Counts
    let onDuty = BPL_FDNet.OnDuty(MapLoad, Dock)

    // the job is moving while any of its goods gained since the last plan or is being carried: then no good's stall
    // clock runs
    let moving = false
    for mres, munits in BPL_FDNet.Manifest(MapLoad, id) {
        let mh = hold.Find(mres)
        let mf = Dock.m_inputStockpile.Slots.Find(mres)
        let mcarried = if mf.ReturnValue { mf.Value.reservedSpaceForDropoff } else { 0 }
        let mgot = (if mh.ReturnValue { mh.Value } else { 0 }) + mcarried
        if mcarried > 0 {
            moving = true
        }
        let mseen = MapLoad.PickupSeen.Find(Key(id, mres))
        if mseen.ReturnValue {
            if mgot > mseen.Value {
                moving = true
            }
        }
    }

    for res, units in BPL_FDNet.Manifest(MapLoad, id) {
        let h = hold.Find(res)
        let inHold = if h.ReturnValue { h.Value } else { 0 }
        let f = Dock.m_inputStockpile.Slots.Find(res)
        let carried = if f.ReturnValue { f.Value.reservedSpaceForDropoff } else { 0 }
        let atDock = if f.ReturnValue { f.Value.count } else { 0 }
        let got = inHold + carried
        InFlight += carried

        // stall: nothing of the job moved (moving) for Stall() seconds while the manifest isn't met: cut it to got
        let key = Key(id, res)
        // copied into variables before PickupSeen is written: a map Find is re-read wherever it is used
        let before = -1
        let seen = MapLoad.PickupSeen.Find(key)
        if seen.ReturnValue {
            before = seen.Value
        }
        let since = MapLoad.PickupSince.Find(key)
        let sinceT = if since.ReturnValue { since.Value } else { now }
        // the stall clock doesn't run while the job is moving, or while the crew is off duty (nobody hauls at night)
        if before < 0 || got > before || got >= units || !onDuty || moving {
            sinceT = now
        }
        MapLoad.PickupSeen[key] = got
        MapLoad.PickupSince[key] = sinceT
        let goal = units
        let cut = false
        if got < units && now - sinceT > Stall() {
            goal = got
            cut = true
            if got > 0 {
                MapLoad.JobGoods[BPL_FDNet.JobKey(id, res)] = got
            } else {
                // nothing of it got: it leaves the job (a job left with nothing is cancelled, BPL_FDDispatch.Upkeep)
                MapLoad.JobGoods.Remove(BPL_FDNet.JobKey(id, res))
                MapLoad.JobGoods.Remove(BPL_FDNet.ParkKey(id, res))
            }
            MapLoad.PickupSince[key] = now
            // for the dock GUI ("good=units,..." until the job ends)
            let was = MapLoad.JobDropped.Find(id)
            let note = string(res) + "=" + string(units - got)
            MapLoad.JobDropped[id] = if was.ReturnValue { was.Value + "," + note } else { note }
            // the dispatcher leaves the good with this dock until its input warehouses' free stock changes
            BPL_FDDispatch.Probe(MapLoad, "Probe: job " + string(id) + " " + string(res) + " stalled, " + string(units) + " -> " + string(got) + " (at dock " + string(atDock) + ")")
            let left = BPL_FDNet.SourceStock(MapLoad, Dock).Stock.Find(res)
            MapLoad.CutStock[BPL_FDNet.JobKey(id, res)] = if left.ReturnValue { left.Value } else { 0 }
        }

        // the manifest, or what is aboard when more (left as it is); what waits in the input slot or is carried
        // doesn't raise it, so hauls don't feed on themselves
        if !NoMore && goal > 0 {
            Request[res] = KismetMathLibrary.Max(goal, inHold)
        }
        // waiting to leave (NoMore): only what is already on its way stays requested, so those haulers aren't
        // turned away
        if NoMore && carried > 0 {
            Request[res] = inHold + carried
        }
        if !NoMore {
            Remaining += KismetMathLibrary.Max(goal - got, 0)
        }
        Detail += string(res) + ": " + string(got) + " of " + string(goal) + " (at dock " + string(atDock) + ", in flight " + string(carried) + (if cut { ", cut: stalled" } else { "" }) + "); "
    }
    Space = 0
    if !NoMore {
        Space = KismetMathLibrary.Max(Ship.config.cargoLimit - held.Total - InFlight, 0)
    }
}

// Writes Want as the dock's request: its dock-specific supplies and live requirement, and per good its input slot's
// capacity, the request less what is in the hold (never the whole request: haulers would be sent for goods already
// aboard). A good that left the request leaves the live requirement, and its input slot's capacity goes to 0. The
// slot's count is the game's bookkeeping for hauls under way, not goods (BPL_FDNet.ClearInputCounts).
fn RequestFor(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Want: ResourceCollection) {
    let old = Dock.m_requiredEmbarkSupplies_dockSpecific.counts
    Dock.m_requiredEmbarkSupplies_dockSpecific = Want
    let ship = BPL_FDNet.ShipAtDock(MapLoad, Dock)
    let hold: map<name, int> = {}
    if ship != none {
        hold = MapLoad.HoldCounts(ship).Counts
    }
    let live = Dock.m_requiredEmbarkSupplies_live
    let pile = Dock.m_inputStockpile
    for res, was in old {
        if !Want.counts.Contains(res) {
            live.counts.Remove(res)
            let f = pile.Slots.Find(res)
            if f.ReturnValue {
                let gone = f.Value
                gone.capacity = 0
                pile.Slots[res] = gone
            }
        }
    }
    for res, units in Want.counts {
        live.counts[res] = units
        let h = hold.Find(res)
        let room = KismetMathLibrary.Max(units - (if h.ReturnValue { h.Value } else { 0 }), 0)
        let g = pile.Slots.Find(res)
        let slot = if g.ReturnValue { g.Value } else { ResourceStockpileSlot(count: 0, capacity: 0) }
        slot.capacity = room
        pile.Slots[res] = slot
    }
    Dock.m_requiredEmbarkSupplies_live = live
    Dock.m_inputStockpile = pile
}

// The panel's Deliver now button (BP_MapLoad.DeliverSelected, ported from fdgen): the selected freight dock's ship sails
// now with what it has, not waiting for goods still being carried to it: its departure is marked pending
// (DepartingSince) and sent by hand (ManualDepart), so it doesn't wait for carriers, and FreightTick runs at once.
// ManualDepart also makes BPL_FDDispatch.Trim note a short departure as sent early.
// No job, ship away or nothing aboard: nothing (the button is disabled then).
fn DeliverSelected(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    let dock = MapLoad.FindDockUnderCursor().Dock
    if dock == none {
        return
    }
    let id = BPL_FDNet.DockId(dock)
    // the dock GUI disables the button then, with the reason as its tooltip
    if MapLoad.Voyages.Contains(id) {
        return
    }
    if BPL_FDNet.TargetOf(MapLoad, dock) == none {
        return
    }
    let ship = BPL_FDNet.ShipAtDock(MapLoad, dock)
    if ship == none {
        return
    }
    if MapLoad.HoldCounts(ship).Total <= 0 {
        return
    }
    MapLoad.DepartingSince[id] = BPL_FDNet.ColonyTime()
    MapLoad.ManualDepart[id] = true
    FreightTick(MapLoad)
}

// Every TickSeconds (BP_MapLoad's FreightTick, its timer; ported from fdgen), for each freight dock with a job: a
// timed trip (no stand-in) arrives TripSeconds after departure; a ship loading asks for its manifest (UpdateRequest)
// and departs (Depart) when full (hold + in flight), when nothing is left to request, or after MaxWaitSeconds since
// its first freight came aboard (LoadingSince). A ship that is full or has nothing left to request while goods are
// still being carried to its dock waits for them first (DepartingSince; the request then only covers what is in
// flight), however long that takes; the depart-after time and Deliver now (ManualDepart) send it at once.
fn FreightTick(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    // not before this load's jobs are back (RestoreJobs)
    if !MapLoad.JobsRestored {
        return
    }
    BPL_FDNet.KeepDocks(MapLoad)
    let now = BPL_FDNet.ColonyTime()
    for dock in MapLoad.Docks {
        let target = BPL_FDNet.TargetOf(MapLoad, dock)
        if target != none {
            DockTick(MapLoad, dock, target, now)
        }
    }
    BPL_FDNet.SaveJobs(MapLoad)
}

fn DockTick(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Target: WorkDock, Now: float) {
    let id = BPL_FDNet.DockId(Dock)
    let ship = BPL_FDNet.ShipAtDock(MapLoad, Dock)
    let departed = MapLoad.DepartedAt.Find(id)
    if departed.ReturnValue {
        // under way: a voyage arrives by itself (BPL_FDVoyage.VoyageTick); a timed trip after TripSeconds
        if !MapLoad.Voyages.Contains(id) {
            if Now - departed.Value >= MapLoad.TripSeconds {
                MapLoad.TransferFrom(Dock, Target)
                MapLoad.DepartedAt.Remove(id)
                MapLoad.LoadingSince.Remove(id)
                MapLoad.ClearRequested(id)
            }
        }
        return
    }
    MapLoad.RecordRequested(Dock)
    let pending = MapLoad.DepartingSince.Contains(id)
    BPL_FDNet.SlotProbe(MapLoad, Dock, "tick, before request")
    let req = MapLoad.UpdateRequest(Dock, Target, ship, pending)
    BPL_FDNet.SlotProbe(MapLoad, Dock, "tick, after request")
    let remaining = req.Remaining
    let inFlight = req.InFlight
    let loaded = MapLoad.HoldCounts(ship).Total
    let freight = MapLoad.FreightCounts(ship, Dock, Target).Freight
    if freight <= 0 {
        return
    }
    // the depart-after clock runs from the first freight aboard
    if !MapLoad.LoadingSince.Contains(id) {
        MapLoad.LoadingSince[id] = Now
    }
    let since = MapLoad.LoadingSince[id]
    if pending {
        // go once the carriers have arrived, or at once after Deliver now
        if inFlight == 0 {
            Depart(MapLoad, Dock, Target, ship, Now)
        } else if MapLoad.ManualDepart.Contains(id) {
            Depart(MapLoad, Dock, Target, ship, Now)
        }
        return
    }
    let full = loaded + inFlight >= ship.config.cargoLimit
    let timedOut = Now - since >= MapLoad.MaxWaitSeconds
    // the depart-after time is up: it leaves now, without the goods still being carried
    if timedOut {
        Depart(MapLoad, Dock, Target, ship, Now)
        return
    }
    let ready = full || remaining == 0
    if !ready {
        return
    }
    if inFlight > 0 {
        // ready, but goods still on their way to the dock: wait for them
        MapLoad.DepartingSince[id] = Now
        return
    }
    Depart(MapLoad, Dock, Target, ship, Now)
}

fn Depart(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Target: WorkDock, Ship: NauticalShip, Now: float) {
    let id = BPL_FDNet.DockId(Dock)
    MapLoad.DepartedAt[id] = Now
    MapLoad.DepartingSince.Remove(id)
    MapLoad.PauseLoading(Dock)
    MapLoad.StartVoyage(Dock, Target, Ship)
}
