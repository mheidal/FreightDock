blueprint BPL_FDPairing : BlueprintFunctionLibrary at /Game/Mods/FreightDock/Loom/BPL_FDPairing

// The arcs and the per-frame hook, ported from fdgen (BP_MapLoad's DrawArcs and PairKeyTick just call these).

// An arc from A to B for this frame.
fn Queue(PC: PlayerController_Play, A: Vector, B: Vector, Tint: Color, Width: float, Height: float) {
    PC.QueueSynchronizedArcPlanForFrame(ArcPlan(worldStart: A, worldEnd: B, Color: Tint, linewidthTop: Width, linewidthEnd: Width, arcHeightRatioOfLength: Height))
}

// Every frame (Event Tick, also while paused): the selected paired dock's route, and each voyage's arc (stand-in to
// where it's heading) while the stand-in is hovered or its dock or target is selected; while hovered, also one to
// its home dock and its course as the route line. Then the selected pair's arc (PairArcs).
fn DrawArcs(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    let pc = GameplayStatics.GetPlayerController(0)
    let play = cast(pc, PlayerController_Play)
    let sel = MapLoad.FindDockUnderCursor().Dock

    // the cursor on the sea plane (z = 0)
    let ray = pc.DeprojectMousePositionToWorld()
    let rayEnd = KismetMathLibrary.Add_VectorVector(ray.WorldLocation, KismetMathLibrary.Multiply_VectorFloat(ray.WorldDirection, 10000000.0))
    let sea = KismetMathLibrary.LinePlaneIntersection_OriginNormal(ray.WorldLocation, rayEnd, Vector(X: 0.0, Y: 0.0, Z: 0.0), Vector(X: 0.0, Y: 0.0, Z: 1.0))
    let cursor = sea.Intersection

    // the selected dock and its target (-999 with nothing selected, -1 with no target)
    let selId = -999
    let selTargetId = -999
    let target: WorkDock = none
    if sel != none {
        selId = BPL_FDNet.DockId(sel)
        target = BPL_FDNet.TargetOf(MapLoad, sel)
        selTargetId = if target == none { -1 } else { BPL_FDNet.DockId(target) }
    }

    // the route arc, worked out again only when the selection changes
    if selId != MapLoad.RouteSelId {
        MapLoad.RouteSelId = selId
        MapLoad.RouteValid = false
        if sel != none && target != none {
            MapLoad.RouteStart = sel.GetOwner().K2_GetActorLocation()
            MapLoad.RouteEnd = target.GetOwner().K2_GetActorLocation()
            MapLoad.RouteValid = true
        }
    }
    if MapLoad.RouteValid {
        MapLoad.DrawRoute(MapLoad.RouteSelId, play)
    }

    // voyage arcs
    for id, proxy in MapLoad.Voyages {
        if KismetSystemLibrary.IsValid(proxy) {
            let pos = proxy.K2_GetActorLocation()
            let phase = MapLoad.VoyagePhase.Find(id)
            let home = MapLoad.VoyageHome.Find(id)
            let away = MapLoad.VoyageTarget.Find(id)
            let dest = if phase.Value >= 2 { home.Value } else { away.Value }
            let hovered = KismetMathLibrary.Vector_Distance2D(cursor, pos) <= MapLoad.HoverRadius
            if hovered || id == selId || id == selTargetId {
                Queue(play, pos, dest, MapLoad.ArcColor, MapLoad.ArcWidth, MapLoad.ArcHeight)
                if hovered {
                    Queue(play, pos, home.Value, MapLoad.ArcColor, MapLoad.ArcWidth, MapLoad.ArcHeight)
                    // after the selected dock's route, so the hovered ship's course wins
                    MapLoad.DrawRoute(id, play)
                }
            }
        }
    }
    // a hovered network configuration replaces the selected dock's own links, so each arc shows once
    if MapLoad.HiFrom.Length() == 0 && MapLoad.HiPts.Length() == 0 {
        NetworkArcs(MapLoad, play, sel)
    }
    Highlights(MapLoad, play)
}

// Sideways shift for the Slot-th of a dock's networks, so a pair linked on several networks gets one arc each.
pure fn Shift(A: Vector, B: Vector, Slot: int) -> Vector {
    let dx = B.X - A.X
    let dy = B.Y - A.Y
    let len = KismetMathLibrary.FMax(KismetMathLibrary.Sqrt(dx * dx + dy * dy), 1.0)
    let k = (float(Slot) - 1.5) * 60.0 / len
    return Vector(X: 0.0 - dy * k, Y: dx * k, Z: 0.0)
}

fn Where(Dock: WorkDock) -> Vector {
    return Dock.GetOwner().K2_GetActorLocation()
}

// The selected freight dock's links: an arc to each dock it provides to and from each dock that provides to it, in
// the network's colour, offset per network.
fn NetworkArcs(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Play: PlayerController_Play, Sel: WorkDock) {
    if Sel == none {
        return
    }
    let u = BPL_FDNet.Unpack(Sel.activeTradePartnerId)
    if !u.IsNew {
        return
    }
    let here = Where(Sel)
    let i = 0
    while i < BPL_FDNet.Slots() {
        let net = u.Nets[i]
        if net > 0 {
            let m = BPL_FDNet.Members(MapLoad, net)
            let tint = BPL_FDNet.NetColor(net)
            if (u.Roles[i] & BPL_FDNet.Provide()) != 0 {
                for r in m.Requesters {
                    if r != Sel {
                        let there = Where(r)
                        let off = Shift(here, there, i)
                        Queue(Play, KismetMathLibrary.Add_VectorVector(here, off), KismetMathLibrary.Add_VectorVector(there, off), tint, MapLoad.ArcWidth, MapLoad.ArcHeight)
                    }
                }
            }
            if (u.Roles[i] & BPL_FDNet.Request()) != 0 {
                for p in m.Providers {
                    if p != Sel {
                        let from = Where(p)
                        let off2 = Shift(from, here, i)
                        Queue(Play, KismetMathLibrary.Add_VectorVector(from, off2), KismetMathLibrary.Add_VectorVector(here, off2), tint, MapLoad.ArcWidth, MapLoad.ArcHeight)
                    }
                }
            }
        }
        i += 1
    }
}

// What the panels highlight while hovered (Highlight fills the lists): arcs and pointers.
fn Highlights(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Play: PlayerController_Play) {
    let i = 0
    while i < MapLoad.HiFrom.Length() {
        Queue(Play, MapLoad.HiFrom[i], MapLoad.HiTo[i], MapLoad.HiArcColor[i], MapLoad.ArcWidth, MapLoad.ArcHeight)
        i += 1
    }
    let k = 0
    while k < MapLoad.HiPts.Length() {
        let foot = MapLoad.HiPts[k]
        // a pointer: a straight line up from the dock (an arc of no height)
        Queue(Play, foot, Vector(X: foot.X, Y: foot.Y, Z: foot.Z + 6000.0), MapLoad.HiPtColor[k], MapLoad.ArcWidth, 0.0)
        k += 1
    }
}

// Fills the highlight lists for a hovered panel part. Kind: 0 nothing, 1 the network (arcs from each provider to
// each requester, pointers on every member), 2 its providers, 3 its requesters, 4 Good (pointers on the providers
// whose inputs can supply it and the requesters asking for it). Pointers are red for providers and blue for
// requesters; a dock that is both gets two, side by side.
fn Highlight(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, Kind: int, Good: name) {
    MapLoad.HiFrom.Clear()
    MapLoad.HiTo.Clear()
    MapLoad.HiArcColor.Clear()
    MapLoad.HiPts.Clear()
    MapLoad.HiPtColor.Clear()
    if Net <= 0 || Kind <= 0 {
        return
    }
    let m = BPL_FDNet.Members(MapLoad, Net)
    if Kind == 1 {
        for p in m.Providers {
            for r in m.Requesters {
                if r != p {
                    MapLoad.HiFrom.Add(Where(p))
                    MapLoad.HiTo.Add(Where(r))
                    MapLoad.HiArcColor.Add(BPL_FDNet.NetColor(Net))
                }
            }
        }
    }
    for p in m.Providers {
        let show = Kind == 1 || Kind == 2
        if Kind == 4 {
            show = BPL_FDNet.SuppliesGood(MapLoad, p, Good)
        }
        if show {
            let at = Where(p)
            MapLoad.HiPts.Add(Vector(X: at.X - 40.0, Y: at.Y, Z: at.Z))
            MapLoad.HiPtColor.Add(BPL_FDNet.ProviderColor())
        }
    }
    for r in m.Requesters {
        let shown = Kind == 1 || Kind == 3
        if Kind == 4 {
            shown = BPL_FDNet.AsksForGood(MapLoad, r, Good)
        }
        if shown {
            let at2 = Where(r)
            MapLoad.HiPts.Add(Vector(X: at2.X + 40.0, Y: at2.Y, Z: at2.Z))
            MapLoad.HiPtColor.Add(BPL_FDNet.RequesterColor())
        }
    }
}

// Every frame (BP_MapLoad.PairKeyTick, from Event Tick, also while paused; the name is kept from the pairing key,
// which the panel's network picker replaced): the dispatcher (BPL_FDDispatch), stand-in clicks, then the panel.
fn Tick(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    BPL_FDDispatch.Tick(MapLoad)
    MapLoad.StandInClick()
    MapLoad.PanelTick()
}
