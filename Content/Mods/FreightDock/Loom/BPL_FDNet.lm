blueprint BPL_FDNet : BlueprintFunctionLibrary at /Game/Mods/FreightDock/Loom/BPL_FDNet

// Freight networks: which networks a freight dock belongs to, and in which role, stored in the game's own
// WorkDock.activeTradePartnerId (it survives a save). See Docs/FreightDock/Many-to-many links.md.
//
//   stored = -(2 + x); x below NetBase(): a 1.x value (one-to-one pair), x = the target's dock ID
//                      x from NetBase() up: a network value, packed = x - NetBase()
//   packed bits:  30, 29, 28 unused | 27 paused | 26..18, 17..9, 8..0 memberships
//   membership (9 bits): 8..7 unused | 6..5 role (0 both, 1 provide, 2 request; 3 read as both) | 4..0 network ID
//                        (1..31; 0 = empty)
//   -1 (or anything above -2) is "no target", as the game uses it.
//
// Rules: unused bits are written 0 and ignored when read, so a later use of one must keep 0 meaning today's behaviour.
// Role 3 is never written, so slot 3's role bits are never both set: packed stays below 2^31 - 2^23 and NetBase() +
// packed always fits. Nothing is cached: queries decode every freight dock's value each time.

pure fn DockId(Dock: WorkDock) -> int {
    let grid = cast(Dock.GetOwner(), GridActor)
    return if grid == none { -1 } else { grid.ID }
}

// Per resource, what the dock's input warehouses hold free (with WithReserved, also what haulers have
// reserved for pickup); HasSources false when none is set.
fn SourceStock(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, WithReserved: bool = false, out Stock: map<name, int>, out HasSources: bool) {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return
    }
    for id in linker.m_sourceStockpileIds {
        HasSources = true
        let b = MapLoad.BuildingById(id).Building
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                for res, slot in rb.m_stockpile.Slots {
                    let free = if WithReserved { slot.count } else { slot.count - slot.reservedForPickup }
                    if free > 0 {
                        let had = Stock.Find(res)
                        Stock[res] = (if had.ReturnValue { had.Value } else { 0 }) + free
                    }
                }
            }
        }
    }
}

// The ship berthed at the dock: the one whose docked berth is the dock's own (NauticalDockAt, playerDock_<id>).
// none when its ship is away or it has none. (Not the nearest ship: two docks side by side would mix up ships.)
fn ShipAtDock(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> NauticalShip {
    if Dock == none {
        return none
    }
    let berth = MapLoad.NauticalDockAt(Dock).Best
    if berth == none {
        return none
    }
    for a in GameplayStatics.GetAllActorsOfClass(NauticalShip).OutActors {
        let ship = cast(a, NauticalShip)
        if ship != none {
            if ship.State.dockedDock == berth {
                return ship
            }
        }
    }
    return none
}

pure fn Slots() -> int {
    return 3
}

// Where network values start (2^22): above every dock ID a 1.x value can hold (IDs are in the ten-thousands), and
// low enough that NetBase() + packed fits (it may be at most 2^23 - 1).
pure fn NetBase() -> int {
    return 4194304
}

// The ship takes no new jobs (BPL_FDDispatch); the current one is finished.
pure fn PausedBit() -> int {
    return 134217728
}

pure fn Provide() -> int {
    return 1
}

pure fn Request() -> int {
    return 2
}

pure fn Both() -> int {
    return 3
}

pure fn MaxNet() -> int {
    return 31
}

// 512 to the power of a membership's index: where its 9 bits start (net 5 bits, role 2, 2 unused).
pure fn Place(Index: int) -> int {
    let p = 1
    let i = 0
    while i < Index {
        p = p * 512
        i += 1
    }
    return p
}

// The stored value decoded. IsNew: a network value. OldTarget: the target's dock ID of a 1.x pair, else -1. Nets and
// Roles always have Slots() entries, lowest network first; an empty membership is net 0, role 0. Roles are 1
// provide, 2 request, 3 both (as Provide() | Request()), whichever way "both" was stored.
pure fn Unpack(Stored: int, out Nets: array<int>, out Roles: array<int>, out Paused: bool, out IsNew: bool, out OldTarget: int) {
    Nets = []
    Roles = []
    Paused = false
    IsNew = false
    OldTarget = -1
    let x = -1
    if Stored <= -2 {
        x = 0 - Stored - 2
    }
    let packed = 0
    if x >= NetBase() {
        IsNew = true
        packed = x - NetBase()
        Paused = (packed & PausedBit()) != 0
    } else if x >= 0 {
        OldTarget = x
    }
    let nets: array<int> = []
    let roles: array<int> = []
    if IsNew {
        let i = 0
        while i < Slots() {
            let m = (packed / Place(i)) % 512
            let net = m % 32
            let role = (m / 32) % 4
            if net != 0 {
                nets.Add(net)
                roles.Add(if role == 0 { Both() } else { role })
            }
            i += 1
        }
    }
    // lowest network first
    let k = 0
    while k < nets.Length() {
        let best = k
        let j = k + 1
        while j < nets.Length() {
            if nets[j] < nets[best] {
                best = j
            }
            j += 1
        }
        if best != k {
            nets.Swap(k, best)
            roles.Swap(k, best)
        }
        k += 1
    }
    let n = 0
    while n < Slots() {
        if n < nets.Length() {
            Nets.Add(nets[n])
            Roles.Add(roles[n])
        } else {
            Nets.Add(0)
            Roles.Add(0)
        }
        n += 1
    }
}

// The stored value for these memberships. Entries past Slots(), with a network outside 1..MaxNet(), or with a role
// outside 1..3 are left out. Both is written as role 0.
pure fn Pack(Nets: array<int>, Roles: array<int>, Paused: bool) -> int {
    let packed = 0
    if Paused {
        packed += PausedBit()
    }
    let slot = 0
    let i = 0
    while i < Nets.Length() && slot < Slots() {
        let net = Nets[i]
        let role = if i < Roles.Length() { Roles[i] } else { 0 }
        if net >= 1 && net <= MaxNet() && role >= 1 && role <= 3 {
            let written = if role == Both() { 0 } else { role }
            packed += (written * 32 + net) * Place(slot)
            slot += 1
        }
        i += 1
    }
    return 0 - (NetBase() + packed) - 2
}

// The dock's role on Net (0 when not a member).
pure fn RoleOn(Stored: int, Net: int) -> int {
    let u = Unpack(Stored)
    let i = 0
    while i < Slots() {
        if u.Nets[i] == Net && Net > 0 {
            return u.Roles[i]
        }
        i += 1
    }
    return 0
}

pure fn Provides(Stored: int, Net: int) -> bool {
    return (RoleOn(Stored, Net) & Provide()) != 0
}

pure fn Requests(Stored: int, Net: int) -> bool {
    return (RoleOn(Stored, Net) & Request()) != 0
}

// The stored value with the dock's role on Net set to Role (0 removes it). Ok is false, and the value unchanged,
// when Net or Role is out of range, or when Net is new and all Slots() memberships are taken. A 1.x value is
// replaced: its pair is dropped.
pure fn With(Stored: int, Net: int, Role: int, out Ok: bool) -> int {
    Ok = false
    if Net < 1 || Net > MaxNet() || Role < 0 || Role > 3 {
        return Stored
    }
    let u = Unpack(Stored)
    let nets = u.Nets
    let roles = u.Roles
    let found = -1
    let free = -1
    let i = 0
    while i < Slots() {
        if nets[i] == Net && found < 0 {
            found = i
        }
        if nets[i] == 0 && free < 0 {
            free = i
        }
        i += 1
    }
    let at = if found >= 0 { found } else { free }
    if at < 0 {
        if Role != 0 {
            return Stored
        }
        Ok = true
        return Stored
    }
    nets[at] = if Role == 0 { 0 } else { Net }
    roles[at] = Role
    Ok = true
    return Pack(nets, roles, u.Paused)
}

// The stored value with the ship paused or not; a value in no network takes the network format to hold the flag.
pure fn WithPaused(Stored: int, Paused: bool) -> int {
    let u = Unpack(Stored)
    return Pack(u.Nets, u.Roles, Paused)
}

pure fn IsPaused(Stored: int) -> bool {
    return Unpack(Stored).Paused
}

// Whether the dock belongs to any network.
pure fn IsMember(Stored: int) -> bool {
    let u = Unpack(Stored)
    for n in u.Nets {
        if n > 0 {
            return true
        }
    }
    return false
}

// Every freight dock (MapLoad.Docks, freight docks only), in dock ID order.
fn FreightDocks(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> array<WorkDock> {
    let out: array<WorkDock> = []
    for d in MapLoad.Docks {
        if d != none {
            if MapLoad.IsFreightDock(d).Result {
                out.Add(d)
            }
        }
    }
    SortById(out)
    return out
}

// Sorts docks by dock ID (insertion sort; there are few).
fn SortById(Docks: ref array<WorkDock>) {
    let i = 1
    while i < Docks.Length() {
        let j = i
        while j > 0 && DockId(Docks[j - 1]) > DockId(Docks[j]) {
            Docks.Swap(j - 1, j)
            j -= 1
        }
        i += 1
    }
}

// The providers and requesters on Net, in dock ID order. A dock with the role "both" is in each.
fn Members(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out Providers: array<WorkDock>, out Requesters: array<WorkDock>) {
    Providers = []
    Requesters = []
    for d in FreightDocks(MapLoad) {
        let role = RoleOn(d.activeTradePartnerId, Net)
        if (role & Provide()) != 0 {
            Providers.Add(d)
        }
        if (role & Request()) != 0 {
            Requesters.Add(d)
        }
    }
}

// The networks with at least one member, ascending, and the lowest ID not in use (0 when all are).
fn InUse(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, out Nets: array<int>, out NextFree: int) {
    Nets = []
    NextFree = 0
    let used: array<int> = []
    for d in FreightDocks(MapLoad) {
        let u = Unpack(d.activeTradePartnerId)
        for n in u.Nets {
            if n > 0 {
                used.AddUnique(n)
            }
        }
    }
    let n = 1
    while n <= MaxNet() {
        if used.Contains(n) {
            Nets.Add(n)
        } else if NextFree == 0 {
            NextFree = n
        }
        n += 1
    }
}

// The docks this dock supplies: requesters on every network it provides on, itself left out, each once, in dock
// ID order (the order round-robin follows).
fn RequestersOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> array<WorkDock> {
    let out: array<WorkDock> = []
    let u = Unpack(Dock.activeTradePartnerId)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Provide()) != 0 {
            let m = Members(MapLoad, u.Nets[i])
            for r in m.Requesters {
                if r != Dock {
                    out.AddUnique(r)
                }
            }
        }
        i += 1
    }
    SortById(out)
    return out
}

// The docks that supply this dock: providers on every network it requests on, itself left out, each once.
fn ProvidersOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> array<WorkDock> {
    let out: array<WorkDock> = []
    let u = Unpack(Dock.activeTradePartnerId)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Request()) != 0 {
            let m = Members(MapLoad, u.Nets[i])
            for p in m.Providers {
                if p != Dock {
                    out.AddUnique(p)
                }
            }
        }
        i += 1
    }
    SortById(out)
    return out
}

// Converts every 1.x pair (A <-> B) into a network of its own, the lowest free ID, with both docks in the role
// "both"; a 1.x value whose target is gone becomes -1. Returns the number of networks made. Once converted, a
// save can't be read by mod 1.x.
fn Migrate(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> int {
    let made = 0
    let docks = FreightDocks(MapLoad)
    for d in docks {
        let u = Unpack(d.activeTradePartnerId)
        if !u.IsNew && u.OldTarget >= 0 {
            let target: WorkDock = none
            for p in docks {
                if DockId(p) == u.OldTarget && p != d {
                    target = p
                }
            }
            if target == none {
                d.activeTradePartnerId = -1
            } else {
                let free = InUse(MapLoad).NextFree
                if free == 0 {
                    // all 31 networks taken: leave the pair as it is
                    continue
                }
                let both = Both()
                d.activeTradePartnerId = Pack([free], [both], false)
                let pu = Unpack(target.activeTradePartnerId)
                if pu.IsNew {
                    let w = With(target.activeTradePartnerId, free, both)
                    target.activeTradePartnerId = w.ReturnValue
                } else {
                    // the target's own value (its pair with d, or with another dock) is replaced
                    target.activeTradePartnerId = Pack([free], [both], false)
                }
                made += 1
            }
        }
    }
    return made
}

// The freight dock with this ID among the known docks (MapLoad.Docks), or none. Cheaper than MapLoad.DockById,
// which looks through every actor.
fn DockIn(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> WorkDock {
    for d in MapLoad.Docks {
        if d != none {
            if DockId(d) == Id {
                return d
            }
        }
    }
    return none
}

// The dock it delivers to: its job's requester (JobTo, given out by BPL_FDDispatch), or none when it has no job. A
// 1.x value gives its old target, until Migrate has run.
fn TargetOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> WorkDock {
    if Dock == none {
        return none
    }
    let u = Unpack(Dock.activeTradePartnerId)
    if !u.IsNew {
        if u.OldTarget >= 0 {
            return DockIn(MapLoad, u.OldTarget)
        }
        return none
    }
    let job = MapLoad.JobTo.Find(DockId(Dock))
    if job.ReturnValue {
        return DockIn(MapLoad, job.Value)
    }
    return none
}

// The value for a dock left in no network: -1, or an empty network value when it is paused.
pure fn Emptied(Stored: int) -> int {
    let u = Unpack(Stored)
    let noNets: array<int> = []
    return if u.Paused { Pack(noNets, noNets, u.Paused) } else { -1 }
}

// Whether the dock is paired: in a network, or holding a 1.x pair.
pure fn IsPaired(Stored: int) -> bool {
    let u = Unpack(Stored)
    return IsMember(Stored) || u.OldTarget >= 0
}

// Whether the dock's crew is at work: by day, from when its first worker is at the dock (MapLoad.CrewArrived) until
// nightfall. Off duty (at night, or in the morning before anyone has walked in), nobody hauls its cargo. Docks have
// no overtime.
fn OnDuty(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> bool {
    let wt = cast(GameplayStatics.GetActorOfClass(WorldTime), WorldTime)
    if wt == none || Dock == none {
        return true
    }
    let id = DockId(Dock)
    if wt.GetDayPhase() != EDayPhase.MID_DAY {
        MapLoad.CrewArrived.Remove(id)
        return false
    }
    if MapLoad.CrewArrived.Contains(id) {
        return true
    }
    for slot in Dock.m_workers.m_workerSlots {
        if slot.present {
            MapLoad.CrewArrived[id] = true
            return true
        }
    }
    return false
}

// Network names, as set in the network GUI (BPL_FDStore, "n<id>"): ID -> name.
fn NetNames(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> map<int, string> {
    let out: map<int, string> = {}
    for key, label in BPL_FDStore.Entries() {
        if KismetStringLibrary.StartsWith(key, "n", ESearchCase.CaseSensitive) {
            let id = KismetStringLibrary.Conv_StringToInt(KismetStringLibrary.RightChop(key, 1))
            if id >= 1 && id <= MaxNet() && label != "" {
                out[id] = label
            }
        }
    }
    return out
}

// Names network Net ("" or blanks: unnamed again).
fn SetNetName(Net: int, Name: string) {
    if Net >= 1 && Net <= MaxNet() {
        BPL_FDStore.Set("n" + string(Net), KismetStringLibrary.TrimTrailing(KismetStringLibrary.Trim(Name)))
    }
}

// Names the dock ("" or blanks, or its default name: unnamed again).
fn SetDockName(Dock: WorkDock, Name: string) {
    if Dock == none {
        return
    }
    let id = DockId(Dock)
    let given = KismetStringLibrary.TrimTrailing(KismetStringLibrary.Trim(Name))
    let unnamed = KismetStringLibrary.EqualEqual_StrStr(given, BPL_FDText.T1("freightdock.dock.unnamed", "id", string(id)))
    BPL_FDStore.Set("d" + string(id), if unnamed { "" } else { given })
}

// "3 Food" for a named network, "3" otherwise.
pure fn NetLabel(Net: int, Names: map<int, string>) -> string {
    let n = Names.Find(Net)
    return if n.ReturnValue { BPL_FDText.T2("freightdock.net.label", "net", string(Net), "name", n.Value) } else { string(Net) }
}

// What a network's requesters ask for, for the panel's picker: per resource, the request levels (minHold) set in
// their output warehouses, and what those warehouses hold of it. A resource is listed whether or not the request is
// met, whatever its amount.
fn NetRequests(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out Wanted: map<name, int>, out Stocked: map<name, int>) {
    let m = Members(MapLoad, Net)
    for r in m.Requesters {
        let linker = cast(r.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
        if linker != none {
            for id in linker.m_destStockpileIds {
                let b = MapLoad.BuildingById(id).Building
                if b != none {
                    let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
                    if rb != none {
                        for res, slot in rb.m_stockpile.Slots {
                            if slot.minHold > 0 {
                                let w = Wanted.Find(res)
                                Wanted[res] = (if w.ReturnValue { w.Value } else { 0 }) + slot.minHold
                                let h = Stocked.Find(res)
                                Stocked[res] = (if h.ReturnValue { h.Value } else { 0 }) + slot.count
                            }
                        }
                    }
                }
            }
        }
    }
}

// The dock's name, as set in the dock GUI (BPL_FDStore, "d<id>"); else "Freight Dock <id>".
fn DockName(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> string {
    let id = DockId(Dock)
    let given = if Dock == none { "" } else { BPL_FDStore.Get("d" + string(id)) }
    return if given == "" { BPL_FDText.T1("freightdock.dock.unnamed", "id", string(id)) } else { given }
}

// Whether the dock has a name of its own.
fn IsNamed(Dock: WorkDock) -> bool {
    if Dock == none {
        return false
    }
    return BPL_FDStore.Get("d" + string(DockId(Dock))) != ""
}

// The goods the network's providers can supply: what their input warehouses whitelist. All is true when any of
// those warehouses accepts everything (no whitelist in use): then every good counts as provided.
fn ProvidedGoods(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out All: bool, out Goods: array<name>) {
    All = false
    Goods = []
    let m = Members(MapLoad, Net)
    for p in m.Providers {
        let linker = cast(p.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
        if linker != none {
            for id in linker.m_sourceStockpileIds {
                let b = MapLoad.BuildingById(id).Building
                if b != none {
                    let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
                    if rb != none {
                        if !rb.m_whiteListReceiving {
                            All = true
                        }
                        for res in rb.m_whitelist {
                            Goods.AddUnique(res)
                        }
                    }
                }
            }
        }
    }
}

// Jobs (BPL_FDDispatch): MapLoad.JobTo[provider id] = requester id; MapLoad.JobGoods["<provider>|<good>"] = units in
// the manifest, and "<provider>|<good>|park" = units of it still to move from the provider's delivered-goods store
// (parked leftovers) into its loading store.
pure fn JobKey(Id: int, Res: name) -> string {
    return string(Id) + "|" + string(Res)
}

pure fn ParkKey(Id: int, Res: name) -> string {
    return string(Id) + "|" + string(Res) + "|park"
}

// The job's manifest (good -> units), without the parked entries.
fn Manifest(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> map<name, int> {
    let out: map<name, int> = {}
    let prefix = string(Id) + "|"
    for key, units in MapLoad.JobGoods {
        if KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) {
            let rest = KismetStringLibrary.RightChop(key, KismetStringLibrary.Len(prefix))
            if !KismetStringLibrary.Contains(rest, "|", true, false) {
                out[name(rest)] = units
            }
        }
    }
    return out
}

// Removes the job and its manifest.
fn DropJob(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) {
    let prefix = string(Id) + "|"
    let gone: array<string> = []
    for key, units in MapLoad.JobGoods {
        if KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) {
            gone.Add(key)
        }
    }
    for key in gone {
        MapLoad.JobGoods.Remove(key)
    }
    MapLoad.JobTo.Remove(Id)
    MapLoad.JobSailed.Remove(Id)
    MapLoad.JobDropped.Remove(Id)
}

// Moves up to Units of Res from the hold of the dock's ship to its delivered-goods store. Returns the units moved.
fn ParkUnits(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Res: name, Units: int) -> int {
    if Dock == none || Units <= 0 {
        return 0
    }
    let ship = BPL_FDNet.ShipAtDock(MapLoad, Dock)
    if ship == none {
        return 0
    }
    let state = ship.State
    let cargo = state.cargo
    let items = cargo.Items
    let item = items.Find(Res)
    if !item.ReturnValue {
        return 0
    }
    let left = item.Value
    let move = KismetMathLibrary.Min(KismetMathLibrary.FFloor(left.Quantity + 0.001), Units)
    if move <= 0 {
        return 0
    }
    left.Quantity = left.Quantity - float(move)
    if left.Quantity < 0.001 {
        items.Remove(Res)
    } else {
        items[Res] = left
    }
    cargo.Items = items
    state.cargo = cargo
    ship.State = state
    let pile = Dock.m_stockpile_goodsFromSea
    let had = pile.Slots.Find(Res)
    let slot = if had.ReturnValue { had.Value } else { ResourceStockpileSlot(count: 0, capacity: 0) }
    slot.count = slot.count + move
    slot.capacity = KismetMathLibrary.Max(slot.capacity, slot.count)
    pile.Slots[Res] = slot
    Dock.m_stockpile_goodsFromSea = pile
    ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Probe: dock " + string(DockId(Dock)) + " hold to delivered-goods store: " + string(Res) + "=" + string(move) + " (store now " + string(slot.count) + ")", false)
    return move
}

// Zeroes the count of each input slot no hauler is bringing goods to (no dropoff reserved): the count isn't goods but
// the game's bookkeeping for hauls under way (2026-11-09: it rose ~13 per trip while the input warehouse never lost
// any, and fell back when the trip ended). Left behind - by a trip cut off when loading stopped, or in a save - it
// fills the slot, and haulers get no room or turn back. Provisions are left to the game. Returns " good=count" per
// slot zeroed.
fn ClearInputCounts(Dock: WorkDock) -> string {
    if Dock == none {
        return ""
    }
    let pile = Dock.m_inputStockpile
    let out = ""
    let keys: array<name> = []
    for res, slot in pile.Slots {
        if slot.count > 0 && slot.reservedSpaceForDropoff == 0 && !Provisions().Contains(res) {
            keys.Add(res)
        }
    }
    for res in keys {
        let slot = pile.Slots[res]
        out += " " + string(res) + "=" + string(slot.count)
        slot.count = 0
        pile.Slots[res] = slot
    }
    if out != "" {
        Dock.m_inputStockpile = pile
    }
    return out
}

// Goods a ship keeps aboard for itself (the game always asks for them): never unloaded as stray freight.
pure fn Provisions() -> array<name> {
    return ["cannedfood"]
}

// Parks everything in the hold of the dock's ship that isn't in Manifest (beyond the manifest's units) and isn't a
// provision: a ship carries only its job's freight. Returns " good=units" per good moved.
fn ParkStray(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Manifest: map<name, int>) -> string {
    if Dock == none {
        return ""
    }
    let ship = ShipAtDock(MapLoad, Dock)
    if ship == none {
        return ""
    }
    let out = ""
    for res, n in MapLoad.HoldCounts(ship).Counts {
        let m = Manifest.Find(res)
        let extra = n - (if m.ReturnValue { m.Value } else { 0 })
        if extra > 0 && !Provisions().Contains(res) {
            let moved = ParkUnits(MapLoad, Dock, res, extra)
            if moved > 0 {
                out += " " + string(res) + "=" + string(moved)
            }
        }
    }
    return out
}

// A colour from 0-255 components (sRGB, as the game's arcs take it).
pure fn Rgb(R: int, G: int, B: int) -> Color {
    return Color(R: KismetMathLibrary.Conv_IntToByte(R), G: KismetMathLibrary.Conv_IntToByte(G), B: KismetMathLibrary.Conv_IntToByte(B), A: KismetMathLibrary.Conv_IntToByte(255))
}

// A network's colour, for its arcs and its number in the panels: one for each of the 31 networks, ten colour families
// in three shades (1-10 light, 11-20 mid, 21-30 deep; 31 white), with red and blue left out (they mark providers and
// requesters). Each entry is 0xRRGGBB.
pure fn NetColor(Net: int) -> Color {
    let palette: array<int> = [16770713, 10682265, 13933055, 16763289, 16751069, 15466393, 10092492, 11180543, 10092526, 12844953, 14727491, 5300291, 10437600, 14716227, 14697388, 12705859, 4448402, 6112224, 4448454, 8773699, 10386712, 2334232, 6690974, 10376728, 10360945, 8625688, 1613403, 3020958, 1613448, 5283352, 15527140]
    let rgb = palette[KismetMathLibrary.Clamp(Net, 1, MaxNet()) - 1]
    return Rgb(rgb / 65536, (rgb / 256) % 256, rgb % 256)
}

pure fn NetLinear(Net: int) -> LinearColor {
    return KismetMathLibrary.Conv_ColorToLinearColor(NetColor(Net))
}

// Pointer colours: providers red (#E9594D), requesters blue (#71D0EA).
pure fn ProviderColor() -> Color {
    return Rgb(233, 89, 77)
}

pure fn RequesterColor() -> Color {
    return Rgb(113, 208, 234)
}

// Whether a provider's input warehouses can supply Good: one whitelists it, or accepts everything.
fn SuppliesGood(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Good: name) -> bool {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return false
    }
    for id in linker.m_sourceStockpileIds {
        let b = MapLoad.BuildingById(id).Building
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                if !rb.m_whiteListReceiving || rb.m_whitelist.Contains(Good) {
                    return true
                }
            }
        }
    }
    return false
}

// Whether a requester's output warehouses have a request set for Good (minHold above 0).
fn AsksForGood(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Good: name) -> bool {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return false
    }
    for id in linker.m_destStockpileIds {
        let b = MapLoad.BuildingById(id).Building
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                let slot = rb.m_stockpile.Slots.Find(Good)
                if slot.ReturnValue && slot.Value.minHold > 0 {
                    return true
                }
            }
        }
    }
    return false
}
