blueprint BPL_FDNet : BlueprintFunctionLibrary at /Game/Mods/FreightDock/Loom/BPL_FDNet

// Freight networks: which networks a freight dock belongs to, and in which role, stored in the game's own
// WorkDock.activeTradePartnerId (it survives a save). See Docs/FreightDock/Many-to-many links.md.
//
//   stored = -(2 + x); x below NetBase(): a 1.x value (one-to-one pair), x = the target's dock ID
//                      x from NetBase() up: a network value, packed = x - NetBase()
//   packed bits:  30, 29, 28 unused | 27 paused | 26..18, 17..9, 8..0 memberships
//   membership (9 bits): 8..7 unused | 6..5 role (0 both, 1 provide, 2 request; 3 read as both) | 4..0 network ID
//                        (1..31; 0 = empty)
//   -1 (or anything above -2) is "no target", as the game uses it.
//
// Rules: unused bits are written 0 and ignored when read, so a later use of one must keep 0 meaning today's behaviour.
// Role 3 is never written, so slot 3's role bits are never both set: packed stays below 2^31 - 2^23 and NetBase() +
// packed always fits. Nothing is cached: queries decode every freight dock's value each time.

pure fn DockId(Dock: WorkDock) -> int {
    let grid = cast(Dock.GetOwner(), GridActor)
    return if grid == none { -1 } else { grid.ID }
}

// Per resource, what the dock's input warehouses hold free (with WithReserved, also what haulers have
// reserved for pickup); HasSources false when none is set.
fn SourceStock(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, WithReserved: bool = false, out Stock: map<name, int>, out HasSources: bool) {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return
    }
    for id in linker.m_sourceStockpileIds {
        HasSources = true
        let b = BuildingById(MapLoad, id)
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                for res, slot in rb.m_stockpile.Slots {
                    let free = if WithReserved { slot.count } else { slot.count - slot.reservedForPickup }
                    if free > 0 {
                        let had = Stock.Find(res)
                        Stock[res] = (if had.ReturnValue { had.Value } else { 0 }) + free
                    }
                }
            }
        }
    }
}

// Every building by ID (MapLoad.Buildings) and the freight docks (MapLoad.Docks), in one pass over the buildings.
// From RefreshDocks (after a rescan: buildings were placed), KeepDocks (every 30 s) and BuildingById (an ID not
// indexed).
fn IndexBuildings(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    let index: map<int, GridActor> = {}
    let docks: array<WorkDock> = []
    for a in GameplayStatics.GetAllActorsOfClass(GridActor).OutActors {
        let b = cast(a, GridActor)
        if b != none {
            index[b.ID] = b
            let wd = cast(b.GetComponentByClass(WorkDock), WorkDock)
            if wd != none {
                if MapLoad.IsFreightDock(wd).Result {
                    docks.Add(wd)
                }
            }
        }
    }
    MapLoad.Buildings = index
    MapLoad.Docks = docks
    MapLoad.IndexedAt = GameplayStatics.GetRealTimeSeconds()
}

// The building with this ID, or none, from the index (IndexBuildings). An ID not in it (a building placed since, or
// gone) indexes again, at most every 5 s: a demolished warehouse still listed on a dock would otherwise do it on
// every call.
fn BuildingById(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> GridActor {
    let found = MapLoad.Buildings.Find(Id)
    if found.ReturnValue {
        if KismetSystemLibrary.IsValid(found.Value) {
            if found.Value.ID == Id {
                return found.Value
            }
        }
    }
    let age = GameplayStatics.GetRealTimeSeconds() - MapLoad.IndexedAt
    if age < 5.0 {
        return none
    }
    IndexBuildings(MapLoad)
    let again = MapLoad.Buildings.Find(Id)
    if again.ReturnValue {
        if KismetSystemLibrary.IsValid(again.Value) {
            return again.Value
        }
    }
    return none
}

// A "Keep empty" warehouse's requests, which GetLogisticsDeficitsAsCollection leaves out: per slot, minHold - count -
// inbound, where positive.
fn KeepEmptyDeficits(Storage: ResourceBuilding) -> map<name, int> {
    let out: map<name, int> = {}
    let inbound = Storage.CalcStorageTab().inbound.counts
    for res, slot in Storage.m_stockpile.Slots {
        let i = inbound.Find(res)
        let need = slot.minHold - slot.count - (if i.ReturnValue { i.Value } else { 0 })
        if need > 0 {
            out[res] = need
        }
    }
    return out
}

// The unmet requests of the dock's output warehouses (the game's "Deliver to", StockpileLinker.m_destStockpileIds),
// summed per good: the game's logistics deficits, or for a "Keep empty" warehouse (which reports none)
// KeepEmptyDeficits. During a dispatch pass (MapLoad.InPass) each dock's is worked out once (MapLoad.PassDeficits).
fn DeficitsFor(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> ResourceCollection {
    let id = DockId(Dock)
    if MapLoad.InPass {
        let kept = MapLoad.PassDeficits.Find(id)
        if kept.ReturnValue {
            return kept.Value
        }
    }
    let counts: map<name, int> = {}
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker != none {
        for bid in linker.m_destStockpileIds {
            let b = BuildingById(MapLoad, bid)
            if b != none {
                let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
                if rb != none {
                    let d: map<name, int> = {}
                    if rb.m_forceEmpty {
                        d = KeepEmptyDeficits(rb)
                    } else {
                        d = rb.GetLogisticsDeficitsAsCollection().counts
                    }
                    for res, n in d {
                        let had = counts.Find(res)
                        counts[res] = (if had.ReturnValue { had.Value } else { 0 }) + n
                    }
                }
            }
        }
    }
    let result = ResourceCollection(counts: counts)
    if MapLoad.InPass {
        MapLoad.PassDeficits[id] = result
    }
    return result
}

// The work dock (freight or not) of the building with this ID, or none.
fn DockById(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> WorkDock {
    let b = BuildingById(MapLoad, Id)
    if b == none {
        return none
    }
    return cast(b.GetComponentByClass(WorkDock), WorkDock)
}

// From FreightTick: demolished docks leave MapLoad.Docks; every 30 s, or with the index never built, everything is
// indexed again (a safety net: placed docks come in through the rescan's RefreshDocks).
fn KeepDocks(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    let age = GameplayStatics.GetRealTimeSeconds() - MapLoad.IndexedAt
    if age >= 30.0 {
        IndexBuildings(MapLoad)
        return
    }
    let kept: array<WorkDock> = []
    for d in MapLoad.Docks {
        if KismetSystemLibrary.IsValid(d) {
            kept.Add(d)
        }
    }
    if kept.Length() != MapLoad.Docks.Length() {
        MapLoad.Docks = kept
    }
}

// The ship berthed at the dock: the one whose docked berth is the dock's own (NauticalDockAt, playerDock_<id>).
// none when its ship is away or it has none. (Not the nearest ship: two docks side by side would mix up ships.)
fn ShipAtDock(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> NauticalShip {
    if Dock == none {
        return none
    }
    let berth = MapLoad.NauticalDockAt(Dock).Best
    if berth == none {
        return none
    }
    for a in GameplayStatics.GetAllActorsOfClass(NauticalShip).OutActors {
        let ship = cast(a, NauticalShip)
        if ship != none {
            if ship.State.dockedDock == berth {
                return ship
            }
        }
    }
    return none
}

// Development only: true turns on the "Probe:" log lines (job events, goods moved; BPL_FDDispatch.Probe). For the
// per-dock probe add WBP_FDPanel.ProbeIdle(Owner) to its Step too (see WBP_FDPanel's ProbeAt).
pure fn Probing() -> bool {
    return false
}

// Development only: true turns on the timing probe (WBP_FDProf, WBP_FDPanel.ProfStep: every 30 s, the time spent in each hooked
// section and what single lookups cost, logged as "Timing:" lines). Keep false in a release.
pure fn Timing() -> bool {
    return false
}

// Real time in ms, for the timing probe; 0 while Timing() is off.
fn Now() -> float {
    if !Timing() {
        return 0.0
    }
    let t = GameplayStatics.GetAccurateRealTime()
    return float(t.Seconds) * 1000.0 + t.PartialSeconds * 1000.0
}

// Timing probe: adds the time since T0 (a Now()) to Key's total.
fn Took(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Key: string, T0: float) {
    if !Timing() {
        return
    }
    let took = Now() - T0
    let found = WidgetBlueprintLibrary.GetAllWidgetsOfClass(WBP_FDProf, true).FoundWidgets
    if found.Length() > 0 {
        let prof = cast(found[0], WBP_FDProf)
        if prof != none {
            prof.Add(Key, took)
        }
    }
}

// The colony clock: seconds of game time the colony has run (WorldTime.m_totalWorldTimeElapsed). It stops when paused,
// speeds up with the game and is kept in the save, so times measured on it carry across a reload. Every persistent
// FreightDock time uses it (loading, departure, dwell, demand ages, stall clocks); game time only before the world is
// ready.
fn ColonyTime() -> float {
    let arco = ArcoSystems.GetArcoSys().ReturnValue
    if arco != none {
        let wt = arco.m_worldTime
        if wt != none {
            return wt.m_totalWorldTimeElapsed
        }
    }
    return GameplayStatics.GetTimeSeconds()
}

// A good's name as the game shows it (its ResourceDef's stringKey); its internal name when it has none.
fn GoodWord(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Good: name) -> string {
    let rdef = ArcoGameInstance.GetResourceDefCopy(MapLoad, Good)
    let word = LocManager.GetWordFromKey(rdef.stringKey)
    return if word == "" { string(Good) } else { word }
}

pure fn Slots() -> int {
    return 3
}

// Where network values start (2^22): above every dock ID a 1.x value can hold (IDs are in the ten-thousands), and
// low enough that NetBase() + packed fits (it may be at most 2^23 - 1).
pure fn NetBase() -> int {
    return 4194304
}

// The ship takes no new jobs (BPL_FDDispatch); the current one is finished.
pure fn PausedBit() -> int {
    return 134217728
}

pure fn Provide() -> int {
    return 1
}

pure fn Request() -> int {
    return 2
}

pure fn Both() -> int {
    return 3
}

pure fn MaxNet() -> int {
    return 31
}

// 512 to the power of a membership's index: where its 9 bits start (net 5 bits, role 2, 2 unused).
pure fn Place(Index: int) -> int {
    let p = 1
    let i = 0
    while i < Index {
        p = p * 512
        i += 1
    }
    return p
}

// The stored value decoded. IsNew: a network value. OldTarget: the target's dock ID of a 1.x pair, else -1. Nets and
// Roles always have Slots() entries, lowest network first; an empty membership is net 0, role 0. Roles are 1
// provide, 2 request, 3 both (as Provide() | Request()), whichever way "both" was stored.
pure fn Unpack(Stored: int, out Nets: array<int>, out Roles: array<int>, out Paused: bool, out IsNew: bool, out OldTarget: int) {
    Nets = []
    Roles = []
    Paused = false
    IsNew = false
    OldTarget = -1
    let x = -1
    if Stored <= -2 {
        x = 0 - Stored - 2
    }
    let packed = 0
    if x >= NetBase() {
        IsNew = true
        packed = x - NetBase()
        Paused = (packed & PausedBit()) != 0
    } else if x >= 0 {
        OldTarget = x
    }
    let nets: array<int> = []
    let roles: array<int> = []
    if IsNew {
        let i = 0
        while i < Slots() {
            let m = (packed / Place(i)) % 512
            let net = m % 32
            let role = (m / 32) % 4
            if net != 0 {
                nets.Add(net)
                roles.Add(if role == 0 { Both() } else { role })
            }
            i += 1
        }
    }
    // lowest network first
    let k = 0
    while k < nets.Length() {
        let best = k
        let j = k + 1
        while j < nets.Length() {
            if nets[j] < nets[best] {
                best = j
            }
            j += 1
        }
        if best != k {
            nets.Swap(k, best)
            roles.Swap(k, best)
        }
        k += 1
    }
    let n = 0
    while n < Slots() {
        if n < nets.Length() {
            Nets.Add(nets[n])
            Roles.Add(roles[n])
        } else {
            Nets.Add(0)
            Roles.Add(0)
        }
        n += 1
    }
}

// The stored value for these memberships. Entries past Slots(), with a network outside 1..MaxNet(), or with a role
// outside 1..3 are left out. Both is written as role 0.
pure fn Pack(Nets: array<int>, Roles: array<int>, Paused: bool) -> int {
    let packed = 0
    if Paused {
        packed += PausedBit()
    }
    let slot = 0
    let i = 0
    while i < Nets.Length() && slot < Slots() {
        let net = Nets[i]
        let role = if i < Roles.Length() { Roles[i] } else { 0 }
        if net >= 1 && net <= MaxNet() && role >= 1 && role <= 3 {
            let written = if role == Both() { 0 } else { role }
            packed += (written * 32 + net) * Place(slot)
            slot += 1
        }
        i += 1
    }
    return 0 - (NetBase() + packed) - 2
}

// The dock's role on Net (0 when not a member).
pure fn RoleOn(Stored: int, Net: int) -> int {
    let u = Unpack(Stored)
    let i = 0
    while i < Slots() {
        if u.Nets[i] == Net && Net > 0 {
            return u.Roles[i]
        }
        i += 1
    }
    return 0
}

pure fn Provides(Stored: int, Net: int) -> bool {
    return (RoleOn(Stored, Net) & Provide()) != 0
}

pure fn Requests(Stored: int, Net: int) -> bool {
    return (RoleOn(Stored, Net) & Request()) != 0
}

// Whether the dock has Role's bit (Provide() or Request()) on any of its networks.
pure fn HasRole(Stored: int, Role: int) -> bool {
    let u = Unpack(Stored)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Role) != 0 {
            return true
        }
        i += 1
    }
    return false
}

// The stored value with the dock's role on Net set to Role (0 removes it). Ok is false, and the value unchanged,
// when Net or Role is out of range, or when Net is new and all Slots() memberships are taken. A 1.x value is
// replaced: its pair is dropped.
pure fn With(Stored: int, Net: int, Role: int, out Ok: bool) -> int {
    Ok = false
    if Net < 1 || Net > MaxNet() || Role < 0 || Role > 3 {
        return Stored
    }
    let u = Unpack(Stored)
    let nets = u.Nets
    let roles = u.Roles
    let found = -1
    let free = -1
    let i = 0
    while i < Slots() {
        if nets[i] == Net && found < 0 {
            found = i
        }
        if nets[i] == 0 && free < 0 {
            free = i
        }
        i += 1
    }
    let at = if found >= 0 { found } else { free }
    if at < 0 {
        if Role != 0 {
            return Stored
        }
        Ok = true
        return Stored
    }
    nets[at] = if Role == 0 { 0 } else { Net }
    roles[at] = Role
    Ok = true
    return Pack(nets, roles, u.Paused)
}

// The stored value with the ship paused or not; a value in no network takes the network format to hold the flag.
pure fn WithPaused(Stored: int, Paused: bool) -> int {
    let u = Unpack(Stored)
    return Pack(u.Nets, u.Roles, Paused)
}

pure fn IsPaused(Stored: int) -> bool {
    return Unpack(Stored).Paused
}

// Whether the dock belongs to any network.
pure fn IsMember(Stored: int) -> bool {
    let u = Unpack(Stored)
    for n in u.Nets {
        if n > 0 {
            return true
        }
    }
    return false
}

// Every freight dock (MapLoad.Docks, freight docks only), in dock ID order.
fn FreightDocks(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> array<WorkDock> {
    let out: array<WorkDock> = []
    for d in MapLoad.Docks {
        if d != none {
            if MapLoad.IsFreightDock(d).Result {
                out.Add(d)
            }
        }
    }
    SortById(out)
    return out
}

// Sorts docks by dock ID (insertion sort; there are few).
fn SortById(Docks: ref array<WorkDock>) {
    let i = 1
    while i < Docks.Length() {
        let j = i
        while j > 0 && DockId(Docks[j - 1]) > DockId(Docks[j]) {
            Docks.Swap(j - 1, j)
            j -= 1
        }
        i += 1
    }
}

// The providers and requesters on Net, in dock ID order. A dock with the role "both" is in each.
fn Members(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out Providers: array<WorkDock>, out Requesters: array<WorkDock>) {
    Providers = []
    Requesters = []
    for d in FreightDocks(MapLoad) {
        let role = RoleOn(d.activeTradePartnerId, Net)
        if (role & Provide()) != 0 {
            Providers.Add(d)
        }
        if (role & Request()) != 0 {
            Requesters.Add(d)
        }
    }
}

// The networks with at least one member, ascending, and the lowest ID not in use (0 when all are).
fn InUse(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, out Nets: array<int>, out NextFree: int) {
    Nets = []
    NextFree = 0
    let used: array<int> = []
    for d in FreightDocks(MapLoad) {
        let u = Unpack(d.activeTradePartnerId)
        for n in u.Nets {
            if n > 0 {
                used.AddUnique(n)
            }
        }
    }
    let n = 1
    while n <= MaxNet() {
        if used.Contains(n) {
            Nets.Add(n)
        } else if NextFree == 0 {
            NextFree = n
        }
        n += 1
    }
}

// The docks this dock supplies: requesters on every network it provides on, itself left out, each once, in dock
// ID order (the order round-robin follows).
fn RequestersOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> array<WorkDock> {
    let out: array<WorkDock> = []
    let u = Unpack(Dock.activeTradePartnerId)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Provide()) != 0 {
            let m = Members(MapLoad, u.Nets[i])
            for r in m.Requesters {
                if r != Dock {
                    out.AddUnique(r)
                }
            }
        }
        i += 1
    }
    SortById(out)
    return out
}

// The docks that supply this dock: providers on every network it requests on, itself left out, each once.
fn ProvidersOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> array<WorkDock> {
    let out: array<WorkDock> = []
    let u = Unpack(Dock.activeTradePartnerId)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Request()) != 0 {
            let m = Members(MapLoad, u.Nets[i])
            for p in m.Providers {
                if p != Dock {
                    out.AddUnique(p)
                }
            }
        }
        i += 1
    }
    SortById(out)
    return out
}

// Converts every 1.x pair (A <-> B) into a network of its own, the lowest free ID, with both docks in the role
// "both"; a 1.x value whose target is gone becomes -1. Returns the number of networks made. Once converted, a
// save can't be read by mod 1.x.
fn Migrate(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> int {
    let made = 0
    let docks = FreightDocks(MapLoad)
    for d in docks {
        let u = Unpack(d.activeTradePartnerId)
        if !u.IsNew && u.OldTarget >= 0 {
            let target: WorkDock = none
            for p in docks {
                if DockId(p) == u.OldTarget && p != d {
                    target = p
                }
            }
            if target == none {
                d.activeTradePartnerId = -1
            } else {
                let free = InUse(MapLoad).NextFree
                if free == 0 {
                    // all 31 networks taken: leave the pair as it is
                    continue
                }
                let both = Both()
                d.activeTradePartnerId = Pack([free], [both], false)
                let pu = Unpack(target.activeTradePartnerId)
                if pu.IsNew {
                    let w = With(target.activeTradePartnerId, free, both)
                    target.activeTradePartnerId = w.ReturnValue
                } else {
                    // the target's own value (its pair with d, or with another dock) is replaced
                    target.activeTradePartnerId = Pack([free], [both], false)
                }
                made += 1
            }
        }
    }
    return made
}

// The freight dock with this ID among the known docks (MapLoad.Docks), or none.
fn DockIn(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> WorkDock {
    for d in MapLoad.Docks {
        if d != none {
            if DockId(d) == Id {
                return d
            }
        }
    }
    return none
}

// The dock it delivers to: its job's requester (JobTo, given out by BPL_FDDispatch), or none when it has no job. A
// 1.x value gives its old target, until Migrate has run.
fn TargetOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> WorkDock {
    if Dock == none {
        return none
    }
    let u = Unpack(Dock.activeTradePartnerId)
    if !u.IsNew {
        if u.OldTarget >= 0 {
            return DockIn(MapLoad, u.OldTarget)
        }
        return none
    }
    let job = MapLoad.JobTo.Find(DockId(Dock))
    if job.ReturnValue {
        return DockIn(MapLoad, job.Value)
    }
    return none
}

// The value for a dock left in no network: -1, or an empty network value when it is paused.
pure fn Emptied(Stored: int) -> int {
    let u = Unpack(Stored)
    let noNets: array<int> = []
    return if u.Paused { Pack(noNets, noNets, u.Paused) } else { -1 }
}

// Whether the dock is paired: in a network, or holding a 1.x pair.
pure fn IsPaired(Stored: int) -> bool {
    let u = Unpack(Stored)
    return IsMember(Stored) || u.OldTarget >= 0
}

// Whether the dock's crew is at work: by day, from when its first worker is at the dock or the first goods are being
// carried to it (MapLoad.CrewArrived) until nightfall. Off duty (at night, or in the morning before anyone has walked in), nobody hauls its cargo. Docks have
// no overtime.
fn OnDuty(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> bool {
    let wt = cast(GameplayStatics.GetActorOfClass(WorldTime), WorldTime)
    if wt == none || Dock == none {
        return true
    }
    let id = DockId(Dock)
    if wt.GetDayPhase() != EDayPhase.MID_DAY {
        MapLoad.CrewArrived.Remove(id)
        return false
    }
    if MapLoad.CrewArrived.Contains(id) {
        return true
    }
    for slot in Dock.m_workers.m_workerSlots {
        if slot.present {
            MapLoad.CrewArrived[id] = true
            return true
        }
    }
    // workers go from home straight to fetch cargo, so goods being carried to the dock also mean the crew is at work
    for res, inSlot in Dock.m_inputStockpile.Slots {
        if inSlot.reservedSpaceForDropoff > 0 {
            MapLoad.CrewArrived[id] = true
            return true
        }
    }
    return false
}

// Network names, as set in the network GUI (BPL_FDStore, "n<id>"): ID -> name.
fn NetNames(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> map<int, string> {
    let out: map<int, string> = {}
    for key, label in BPL_FDStore.Entries(MapLoad) {
        if KismetStringLibrary.StartsWith(key, "n", ESearchCase.CaseSensitive) {
            let id = KismetStringLibrary.Conv_StringToInt(KismetStringLibrary.RightChop(key, 1))
            if id >= 1 && id <= MaxNet() && label != "" {
                out[id] = label
            }
        }
    }
    return out
}

// Names network Net ("" or blanks: unnamed again).
fn SetNetName(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, Name: string) {
    if Net >= 1 && Net <= MaxNet() {
        BPL_FDStore.Set(MapLoad, "n" + string(Net), KismetStringLibrary.TrimTrailing(KismetStringLibrary.Trim(Name)))
    }
}

// Names the dock ("" or blanks, or its default name: unnamed again).
fn SetDockName(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Name: string) {
    if Dock == none {
        return
    }
    let id = DockId(Dock)
    let given = KismetStringLibrary.TrimTrailing(KismetStringLibrary.Trim(Name))
    let unnamed = KismetStringLibrary.EqualEqual_StrStr(given, BPL_FDText.T1("freightdock.dock.unnamed", "id", string(id)))
    BPL_FDStore.Set(MapLoad, "d" + string(id), if unnamed { "" } else { given })
}

// "3 Food" for a named network, "3" otherwise.
pure fn NetLabel(Net: int, Names: map<int, string>) -> string {
    let n = Names.Find(Net)
    return if n.ReturnValue { BPL_FDText.T2("freightdock.net.label", "net", string(Net), "name", n.Value) } else { string(Net) }
}

// What a network's requesters ask for, for the panel's picker: per resource, the request levels (minHold) set in
// their output warehouses, and what those warehouses hold of it. A resource is listed whether or not the request is
// met, whatever its amount.
fn NetRequests(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out Wanted: map<name, int>, out Stocked: map<name, int>) {
    let m = Members(MapLoad, Net)
    for r in m.Requesters {
        let linker = cast(r.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
        if linker != none {
            for id in linker.m_destStockpileIds {
                let b = BuildingById(MapLoad, id)
                if b != none {
                    let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
                    if rb != none {
                        for res, slot in rb.m_stockpile.Slots {
                            if slot.minHold > 0 {
                                let w = Wanted.Find(res)
                                Wanted[res] = (if w.ReturnValue { w.Value } else { 0 }) + slot.minHold
                                let h = Stocked.Find(res)
                                Stocked[res] = (if h.ReturnValue { h.Value } else { 0 }) + slot.count
                            }
                        }
                    }
                }
            }
        }
    }
}

// The dock's name, as set in the dock GUI (BPL_FDStore, "d<id>"); else "Freight Dock <id>".
fn DockName(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> string {
    let id = DockId(Dock)
    let given = if Dock == none { "" } else { BPL_FDStore.Get(MapLoad, "d" + string(id)) }
    return if given == "" { BPL_FDText.T1("freightdock.dock.unnamed", "id", string(id)) } else { given }
}

// Whether the dock has a name of its own.
fn IsNamed(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> bool {
    if Dock == none {
        return false
    }
    return BPL_FDStore.Get(MapLoad, "d" + string(DockId(Dock))) != ""
}

// The goods the network's providers can supply: what their input warehouses whitelist. All is true when any of
// those warehouses accepts everything (no whitelist in use): then every good counts as provided.
fn ProvidedGoods(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out All: bool, out Goods: array<name>) {
    All = false
    Goods = []
    let m = Members(MapLoad, Net)
    for p in m.Providers {
        let linker = cast(p.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
        if linker != none {
            for id in linker.m_sourceStockpileIds {
                let b = BuildingById(MapLoad, id)
                if b != none {
                    let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
                    if rb != none {
                        if !rb.m_whiteListReceiving {
                            All = true
                        }
                        for res in rb.m_whitelist {
                            Goods.AddUnique(res)
                        }
                    }
                }
            }
        }
    }
}

// Jobs (BPL_FDDispatch): MapLoad.JobTo[provider id] = requester id; MapLoad.JobGoods["<provider>|<good>"] = units in
// the manifest, and "<provider>|<good>|park" = units of it still to move from the provider's delivered-goods store
// (parked leftovers) into its loading store.
pure fn JobKey(Id: int, Res: name) -> string {
    return string(Id) + "|" + string(Res)
}

pure fn ParkKey(Id: int, Res: name) -> string {
    return string(Id) + "|" + string(Res) + "|park"
}

// The job's manifest (good -> units), without the parked entries.
fn Manifest(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> map<name, int> {
    let out: map<name, int> = {}
    let prefix = string(Id) + "|"
    for key, units in MapLoad.JobGoods {
        if KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) {
            let rest = KismetStringLibrary.RightChop(key, KismetStringLibrary.Len(prefix))
            if !KismetStringLibrary.Contains(rest, "|", true, false) {
                out[name(rest)] = units
            }
        }
    }
    return out
}

// Job states, per provider dock (MapLoad.JobState; a dock without an entry is idle). SetState is their only writer.
// Voyages and the voyage maps hold a stand-in's data: a timed trip (no stand-in) has a state without them.
// 0 idle: no job.
// 1 loading: a job, its ship at home taking the manifest aboard.
// 2 depart pending: ready (or sent with Deliver now), waiting for goods still being carried to the dock.
// 3 outbound: sailing to the requester (a timed trip without a stand-in stays here until it delivers).
// 4 dwell: delivered, waiting at the requester.
// 5 homeward: sailing home.
// 6 returned: home, until the dispatcher closes the job (BPL_FDDispatch.Complete).
pure fn StateIdle() -> int {
    return 0
}

pure fn StateLoading() -> int {
    return 1
}

pure fn StateDepartPending() -> int {
    return 2
}

pure fn StateOutbound() -> int {
    return 3
}

pure fn StateDwell() -> int {
    return 4
}

pure fn StateHomeward() -> int {
    return 5
}

pure fn StateReturned() -> int {
    return 6
}

pure fn StateName(State: int) -> string {
    if State == 1 {
        return "loading"
    }
    if State == 2 {
        return "depart pending"
    }
    if State == 3 {
        return "outbound"
    }
    if State == 4 {
        return "dwell"
    }
    if State == 5 {
        return "homeward"
    }
    if State == 6 {
        return "returned"
    }
    return "idle"
}

// The moves a job makes: idle -> loading (given); loading -> depart pending, outbound, idle (cancelled); depart
// pending -> outbound, idle; outbound -> dwell, returned (a timed trip, or its ship left its berth); dwell ->
// homeward, returned; homeward -> returned; returned -> idle (complete).
pure fn StateMove(From: int, To: int) -> bool {
    if From == 0 {
        return To == 1
    }
    if From == 1 {
        return To == 2 || To == 3 || To == 0
    }
    if From == 2 {
        return To == 3 || To == 0
    }
    if From == 3 {
        return To == 4 || To == 6
    }
    if From == 4 {
        return To == 5 || To == 6
    }
    if From == 5 {
        return To == 6
    }
    return To == 0
}

pure fn StateOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> int {
    let s = MapLoad.JobState.Find(Id)
    return if s.ReturnValue { s.Value } else { 0 }
}

// Away from home: outbound, at the requester or homeward.
pure fn IsSailing(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> bool {
    let s = StateOf(MapLoad, Id)
    return s >= 3 && s <= 5
}

// Dock Id's job moves to state To, logged as "State: dock <id> <from> -> <to>"; a move StateMove doesn't have is
// made all the same and marked in the log.
fn SetState(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int, To: int) {
    let from = StateOf(MapLoad, Id)
    if from == To {
        return
    }
    if To == 0 {
        MapLoad.JobState.Remove(Id)
    } else {
        MapLoad.JobState[Id] = To
    }
    let legal = StateMove(from, To)
    ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "State: dock " + string(Id) + " " + StateName(from) + " -> " + StateName(To) + (if legal { "" } else { " (UNEXPECTED MOVE)" }), false)
}

// After a load (BPL_FDLoad.RestoreJob): dock Id's job is in state To, as it was saved.
fn RestoreState(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int, To: int) {
    MapLoad.JobState[Id] = To
    ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "State: dock " + string(Id) + " restored as " + StateName(To), false)
}

// Removes the job and its manifest.
fn DropJob(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) {
    let prefix = string(Id) + "|"
    let gone: array<string> = []
    for key, units in MapLoad.JobGoods {
        if KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) {
            gone.Add(key)
        }
    }
    for key in gone {
        MapLoad.JobGoods.Remove(key)
    }
    MapLoad.JobTo.Remove(Id)
    MapLoad.JobDropped.Remove(Id)
    MapLoad.JobShort.Remove(Id)
    MapLoad.ManualDepart.Remove(Id)
    SetState(MapLoad, Id, StateIdle())
    BPL_FDStore.Set(MapLoad, "j" + string(Id), "")
}

// The format version of job entries (JobEntry).
pure fn JobFormat() -> string {
    return "2"
}

// A time as whole colony-clock seconds, or "" without one.
fn TimeField(Times: map<int, float>, Id: int) -> string {
    let t = Times.Find(Id)
    return if t.ReturnValue { string(KismetMathLibrary.Round(t.Value)) } else { "" }
}

// Job Id as a colony event-flag entry ("j<provider>", lower case, fields split by ";"): format version; requester;
// state (StateOf); loading since, departed at (colony clock, "" when not set); "m" when sent with Deliver now; the
// end of the dwell at the requester; the manifest "good:units:parked,..."; the left-short / sent-early note
// (JobShort, "/" as "-": names may not keep a "/"); the dropped-goods note (JobDropped). Without the notes when it
// would be longer than BPL_FDStore.MaxLongLength. BPL_FDLoad.RestoreJob also reads the format before this one.
fn JobEntry(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int) -> string {
    let goods = ""
    for res, units in Manifest(MapLoad, Id) {
        let pk = MapLoad.JobGoods.Find(ParkKey(Id, res))
        goods += (if goods == "" { "" } else { "," }) + string(res) + ":" + string(units) + ":" + string(if pk.ReturnValue { pk.Value } else { 0 })
    }
    let wait = MapLoad.VoyageWait.Find(Id)
    let short = MapLoad.JobShort.Find(Id)
    let dropped = MapLoad.JobDropped.Find(Id)
    let head = JobFormat() + ";" + string(MapLoad.JobTo[Id]) + ";" + string(StateOf(MapLoad, Id)) + ";" + TimeField(MapLoad.LoadingSince, Id) + ";" + TimeField(MapLoad.DepartedAt, Id) + ";" + (if MapLoad.ManualDepart.Contains(Id) { "m" } else { "" }) + ";" + (if wait.ReturnValue { string(KismetMathLibrary.Round(wait.Value)) } else { "" }) + ";" + goods
    let notes = ";" + KismetStringLibrary.Replace(if short.ReturnValue { short.Value } else { "" }, "/", "-", ESearchCase.CaseSensitive) + ";" + (if dropped.ReturnValue { dropped.Value } else { "" })
    let entry = KismetStringLibrary.ToLower(head + notes)
    if KismetStringLibrary.Len(entry) > BPL_FDStore.MaxLongLength() {
        entry = KismetStringLibrary.ToLower(head + ";;")
    }
    return entry
}

// Writes every job's entry (JobEntry, "j<provider>") and each requester's demand ages ("a<requester>":
// "good:since,...", colony clock) where they differ from what is stored. After each dispatch pass and FreightTick,
// and when a voyage arrives or turns for home; DropJob removes a job's entry when it ends.
fn SaveJobs(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    // not before this load's entries have been read back (BPL_FDLoad.RestoreJobs)
    if !MapLoad.JobsRestored {
        return
    }
    for pid, rid in MapLoad.JobTo {
        let jv = JobEntry(MapLoad, pid)
        let jk = "j" + string(pid)
        if BPL_FDStore.Get(MapLoad, jk) != jv {
            BPL_FDStore.SetLong(MapLoad, jk, jv)
        }
    }
    let ages: map<int, string> = {}
    for dk, t0 in MapLoad.DemandSince {
        let parts = KismetStringLibrary.Split(dk, "|", ESearchCase.CaseSensitive, ESearchDir.FromStart)
        let rq = KismetStringLibrary.Conv_StringToInt(parts.LeftS)
        let had = ages.Find(rq)
        let part = KismetStringLibrary.ToLower(parts.RightS) + ":" + string(KismetMathLibrary.Round(t0))
        ages[rq] = if had.ReturnValue { had.Value + "," + part } else { part }
    }
    for rq2, av in ages {
        let ak = "a" + string(rq2)
        if BPL_FDStore.Get(MapLoad, ak) != av {
            BPL_FDStore.SetLong(MapLoad, ak, av)
        }
    }
    // requesters with no open demand any more: their entry goes
    for key, value in BPL_FDStore.Entries(MapLoad) {
        let rq3 = EntryId(key, "a")
        if rq3 > 0 {
            if !ages.Contains(rq3) {
                BPL_FDStore.Set(MapLoad, key, "")
            }
        }
    }
}

// The ID in an entry key of the form Prefix + a number ("j12387" with "j"), or 0 for any other key (other kinds,
// or keys a later version may add, which are left alone).
pure fn EntryId(Key: string, Prefix: string) -> int {
    if !KismetStringLibrary.StartsWith(Key, Prefix, ESearchCase.CaseSensitive) {
        return 0
    }
    let rest = KismetStringLibrary.RightChop(Key, KismetStringLibrary.Len(Prefix))
    let id = KismetStringLibrary.Conv_StringToInt(rest)
    return if id > 0 && string(id) == rest { id } else { 0 }
}

// Moves up to Units of Res from the hold of the dock's ship to its delivered-goods store. Returns the units moved.
fn ParkUnits(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Res: name, Units: int) -> int {
    if Dock == none || Units <= 0 {
        return 0
    }
    let ship = BPL_FDNet.ShipAtDock(MapLoad, Dock)
    if ship == none {
        return 0
    }
    let state = ship.State
    let cargo = state.cargo
    let items = cargo.Items
    let item = items.Find(Res)
    if !item.ReturnValue {
        return 0
    }
    let left = item.Value
    let move = KismetMathLibrary.Min(KismetMathLibrary.FFloor(left.Quantity + 0.001), Units)
    if move <= 0 {
        return 0
    }
    left.Quantity = left.Quantity - float(move)
    if left.Quantity < 0.001 {
        items.Remove(Res)
    } else {
        items[Res] = left
    }
    cargo.Items = items
    state.cargo = cargo
    ship.State = state
    let pile = Dock.m_stockpile_goodsFromSea
    let had = pile.Slots.Find(Res)
    let slot = if had.ReturnValue { had.Value } else { ResourceStockpileSlot(count: 0, capacity: 0) }
    slot.count = slot.count + move
    slot.capacity = KismetMathLibrary.Max(slot.capacity, slot.count)
    pile.Slots[Res] = slot
    Dock.m_stockpile_goodsFromSea = pile
    if Probing() {
        ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Probe: dock " + string(DockId(Dock)) + " hold to delivered-goods store: " + string(Res) + "=" + string(move) + " (store now " + string(slot.count) + ")", false)
    }
    return move
}

// Development only: true logs the input slots of docks with jobs (SlotProbe) in the first 90 s of real time after a
// load. Keep false in a release.
pure fn LoadProbing() -> bool {
    return false
}

// Development only (LoadProbing): "Slots <label>: dock <id> good count/reserved dropoff/reserved pickup/capacity ...;
// hold <n>", in the first 90 s after a load.
fn SlotProbe(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Label: string) {
    if !LoadProbing() {
        return
    }
    if Dock == none {
        return
    }
    if GameplayStatics.GetRealTimeSeconds() > 90.0 {
        return
    }
    let line = "Slots " + Label + ": dock " + string(DockId(Dock))
    for res, slot in Dock.m_inputStockpile.Slots {
        line += " " + string(res) + " " + string(slot.count) + "/" + string(slot.reservedSpaceForDropoff) + "/" + string(slot.reservedForPickup) + "/" + string(slot.capacity)
    }
    let ship = ShipAtDock(MapLoad, Dock)
    if ship != none {
        line += "; hold " + string(MapLoad.HoldCounts(ship).Total)
    }
    ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + line, false)
}

// Zeroes the count of each input slot no hauler is bringing goods to (no dropoff reserved): the count isn't goods but
// the game's bookkeeping for hauls under way (2026-11-09: it rose ~13 per trip while the input warehouse never lost
// any, and fell back when the trip ended). Left behind - by a trip cut off when loading stopped, or in a save - it
// fills the slot, and haulers get no room or turn back. Provisions are left to the game. Returns " good=count" per
// slot zeroed.
fn ClearInputCounts(Dock: WorkDock) -> string {
    if Dock == none {
        return ""
    }
    let pile = Dock.m_inputStockpile
    let out = ""
    let keys: array<name> = []
    for res, slot in pile.Slots {
        if slot.count > 0 && slot.reservedSpaceForDropoff == 0 && !Provisions().Contains(res) {
            keys.Add(res)
        }
    }
    for res in keys {
        let slot = pile.Slots[res]
        out += " " + string(res) + "=" + string(slot.count)
        slot.count = 0
        pile.Slots[res] = slot
    }
    if out != "" {
        Dock.m_inputStockpile = pile
    }
    return out
}

// Goods a ship keeps aboard for itself (the game always asks for them): never unloaded as stray freight.
pure fn Provisions() -> array<name> {
    return ["cannedfood"]
}

// Parks everything in the hold of the dock's ship that isn't in Manifest (beyond the manifest's units) and isn't a
// provision: a ship carries only its job's freight. Returns " good=units" per good moved.
fn ParkStray(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Manifest: map<name, int>) -> string {
    if Dock == none {
        return ""
    }
    let ship = ShipAtDock(MapLoad, Dock)
    if ship == none {
        return ""
    }
    let out = ""
    for res, n in MapLoad.HoldCounts(ship).Counts {
        let m = Manifest.Find(res)
        let extra = n - (if m.ReturnValue { m.Value } else { 0 })
        if extra > 0 && !Provisions().Contains(res) {
            let moved = ParkUnits(MapLoad, Dock, res, extra)
            if moved > 0 {
                out += " " + string(res) + "=" + string(moved)
            }
        }
    }
    return out
}

// A colour from 0-255 components (sRGB, as the game's arcs take it).
pure fn Rgb(R: int, G: int, B: int) -> Color {
    return Color(R: KismetMathLibrary.Conv_IntToByte(R), G: KismetMathLibrary.Conv_IntToByte(G), B: KismetMathLibrary.Conv_IntToByte(B), A: KismetMathLibrary.Conv_IntToByte(255))
}

// A network's colour, for its arcs and its number in the panels: one for each of the 31 networks, ten colour families
// in three shades (1-10 light, 11-20 mid, 21-30 deep; 31 white), with red and blue left out (they mark providers and
// requesters). Each entry is 0xRRGGBB.
pure fn NetColor(Net: int) -> Color {
    let palette: array<int> = [16770713, 10682265, 13933055, 16763289, 16751069, 15466393, 10092492, 11180543, 10092526, 12844953, 14727491, 5300291, 10437600, 14716227, 14697388, 12705859, 4448402, 6112224, 4448454, 8773699, 10386712, 2334232, 6690974, 10376728, 10360945, 8625688, 1613403, 3020958, 1613448, 5283352, 15527140]
    let rgb = palette[KismetMathLibrary.Clamp(Net, 1, MaxNet()) - 1]
    return Rgb(rgb / 65536, (rgb / 256) % 256, rgb % 256)
}

pure fn NetLinear(Net: int) -> LinearColor {
    return KismetMathLibrary.Conv_ColorToLinearColor(NetColor(Net))
}

// Pointer colours: providers red (#E9594D), requesters blue (#71D0EA).
pure fn ProviderColor() -> Color {
    return Rgb(233, 89, 77)
}

pure fn RequesterColor() -> Color {
    return Rgb(113, 208, 234)
}

// Whether a provider's input warehouses can supply Good: one whitelists it, or accepts everything.
fn SuppliesGood(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Good: name) -> bool {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return false
    }
    for id in linker.m_sourceStockpileIds {
        let b = BuildingById(MapLoad, id)
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                if !rb.m_whiteListReceiving || rb.m_whitelist.Contains(Good) {
                    return true
                }
            }
        }
    }
    return false
}

// Whether a requester's output warehouses have a request set for Good (minHold above 0).
fn AsksForGood(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, Good: name) -> bool {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return false
    }
    for id in linker.m_destStockpileIds {
        let b = BuildingById(MapLoad, id)
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                let slot = rb.m_stockpile.Slots.Find(Good)
                if slot.ReturnValue && slot.Value.minHold > 0 {
                    return true
                }
            }
        }
    }
    return false
}
