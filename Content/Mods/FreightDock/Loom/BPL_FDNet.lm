blueprint BPL_FDNet : BlueprintFunctionLibrary at /Game/Mods/FreightDock/Loom/BPL_FDNet

// Freight networks: which networks a freight dock belongs to, and in which role, stored in the game's own
// WorkDock.activeTradePartnerId (it survives a save). See Docs/FreightDock/Many-to-many links.md.
//
//   stored = -(2 + packed)
//   packed bits:  30 format | 29 reserved (clear) | 28 depart only when full | 27..21, 20..14, 13..7, 6..0 memberships
//   membership (7 bits): 6..5 role (1 provide, 2 request, 3 both) | 4..0 network ID (1..31; 0 = empty)
//
// Older values (mod 1.x, one-to-one pairs) are -2 - partnerDockId: no format bit. -1 (or anything above -2) is
// "no partner", as the game uses it. Nothing is cached: queries decode every freight dock's value each time.

pure fn DockId(Dock: WorkDock) -> int {
    let grid = cast(Dock.GetOwner(), GridActor)
    return if grid == none { -1 } else { grid.ID }
}

// Per resource, what the dock's input warehouses hold free (with WithReserved, also what haulers have
// reserved for pickup); HasSources false when none is set.
fn SourceStock(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, WithReserved: bool = false, out Stock: map<name, int>, out HasSources: bool) {
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker == none {
        return
    }
    for id in linker.m_sourceStockpileIds {
        HasSources = true
        let b = MapLoad.BuildingById(id).Building
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                for res, slot in rb.m_stockpile.Slots {
                    let free = if WithReserved { slot.count } else { slot.count - slot.reservedForPickup }
                    if free > 0 {
                        let had = Stock.Find(res)
                        Stock[res] = (if had.ReturnValue { had.Value } else { 0 }) + free
                    }
                }
            }
        }
    }
}

// The ship berthed at the dock: the one whose docked berth is the dock's own (NauticalDockAt, playerDock_<id>).
// none when its ship is away or it has none. (Not the nearest ship: two docks side by side would mix up ships.)
fn ShipAtDock(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> NauticalShip {
    if Dock == none {
        return none
    }
    let berth = MapLoad.NauticalDockAt(Dock).Best
    if berth == none {
        return none
    }
    for a in GameplayStatics.GetAllActorsOfClass(NauticalShip).OutActors {
        let ship = cast(a, NauticalShip)
        if ship != none {
            if ship.State.dockedDock == berth {
                return ship
            }
        }
    }
    return none
}

pure fn Slots() -> int {
    return 4
}

pure fn FormatBit() -> int {
    return 1073741824
}

pure fn FullBit() -> int {
    return 268435456
}

pure fn Provide() -> int {
    return 1
}

pure fn Request() -> int {
    return 2
}

pure fn Both() -> int {
    return 3
}

pure fn MaxNet() -> int {
    return 31
}

// 128 to the power of a membership's index: where its 7 bits start.
pure fn Place(Index: int) -> int {
    let p = 1
    let i = 0
    while i < Index {
        p = p * 128
        i += 1
    }
    return p
}

// The stored value decoded. IsNew: in the network format. OldPartner: the partner's dock ID of a 1.x pair, else -1.
// Nets and Roles always have Slots() entries; an empty membership is net 0, role 0.
pure fn Unpack(Stored: int, out Nets: array<int>, out Roles: array<int>, out Full: bool, out IsNew: bool, out OldPartner: int) {
    Nets = []
    Roles = []
    Full = false
    IsNew = false
    OldPartner = -1
    let packed = -1
    if Stored <= -2 {
        packed = 0 - Stored - 2
    }
    if packed >= 0 && (packed & FormatBit()) != 0 {
        IsNew = true
        Full = (packed & FullBit()) != 0
    } else if packed >= 0 {
        OldPartner = packed
    }
    let i = 0
    while i < Slots() {
        let net = 0
        let role = 0
        if IsNew {
            let m = (packed / Place(i)) % 128
            net = m % 32
            role = m / 32
            if net == 0 || role == 0 {
                net = 0
                role = 0
            }
        }
        Nets.Add(net)
        Roles.Add(role)
        i += 1
    }
}

// The stored value for these memberships. Entries past Slots(), with a network outside 1..MaxNet(), or with a role
// outside 1..3 are left out.
pure fn Pack(Nets: array<int>, Roles: array<int>, Full: bool) -> int {
    let packed = FormatBit()
    if Full {
        packed += FullBit()
    }
    let slot = 0
    let i = 0
    while i < Nets.Length() && slot < Slots() {
        let net = Nets[i]
        let role = if i < Roles.Length() { Roles[i] } else { 0 }
        if net >= 1 && net <= MaxNet() && role >= 1 && role <= 3 {
            packed += (role * 32 + net) * Place(slot)
            slot += 1
        }
        i += 1
    }
    return 0 - packed - 2
}

// The dock's role on Net (0 when not a member).
pure fn RoleOn(Stored: int, Net: int) -> int {
    let u = Unpack(Stored)
    let i = 0
    while i < Slots() {
        if u.Nets[i] == Net && Net > 0 {
            return u.Roles[i]
        }
        i += 1
    }
    return 0
}

pure fn Provides(Stored: int, Net: int) -> bool {
    return (RoleOn(Stored, Net) & Provide()) != 0
}

pure fn Requests(Stored: int, Net: int) -> bool {
    return (RoleOn(Stored, Net) & Request()) != 0
}

// The stored value with the dock's role on Net set to Role (0 removes it). Ok is false, and the value unchanged,
// when Net or Role is out of range, or when Net is new and all Slots() memberships are taken. A 1.x value is
// replaced: its pair is dropped.
pure fn With(Stored: int, Net: int, Role: int, out Ok: bool) -> int {
    Ok = false
    if Net < 1 || Net > MaxNet() || Role < 0 || Role > 3 {
        return Stored
    }
    let u = Unpack(Stored)
    let nets = u.Nets
    let roles = u.Roles
    let found = -1
    let free = -1
    let i = 0
    while i < Slots() {
        if nets[i] == Net && found < 0 {
            found = i
        }
        if nets[i] == 0 && free < 0 {
            free = i
        }
        i += 1
    }
    let at = if found >= 0 { found } else { free }
    if at < 0 {
        if Role != 0 {
            return Stored
        }
        Ok = true
        return Stored
    }
    nets[at] = if Role == 0 { 0 } else { Net }
    roles[at] = Role
    Ok = true
    return Pack(nets, roles, u.Full)
}

// The stored value with the "depart only when full" flag set or cleared.
pure fn WithFull(Stored: int, Full: bool) -> int {
    let u = Unpack(Stored)
    return Pack(u.Nets, u.Roles, Full)
}

// Whether the dock belongs to any network.
pure fn IsMember(Stored: int) -> bool {
    let u = Unpack(Stored)
    for n in u.Nets {
        if n > 0 {
            return true
        }
    }
    return false
}

// Every freight dock (MapLoad.Docks, freight docks only), in dock ID order.
fn FreightDocks(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> array<WorkDock> {
    let out: array<WorkDock> = []
    for d in MapLoad.Docks {
        if d != none {
            if MapLoad.IsFreightDock(d).Result {
                out.Add(d)
            }
        }
    }
    SortById(out)
    return out
}

// Sorts docks by dock ID (insertion sort; there are few).
fn SortById(Docks: ref array<WorkDock>) {
    let i = 1
    while i < Docks.Length() {
        let j = i
        while j > 0 && DockId(Docks[j - 1]) > DockId(Docks[j]) {
            Docks.Swap(j - 1, j)
            j -= 1
        }
        i += 1
    }
}

// The providers and requesters on Net, in dock ID order. A dock with the role "both" is in each.
fn Members(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Net: int, out Providers: array<WorkDock>, out Requesters: array<WorkDock>) {
    Providers = []
    Requesters = []
    for d in FreightDocks(MapLoad) {
        let role = RoleOn(d.activeTradePartnerId, Net)
        if (role & Provide()) != 0 {
            Providers.Add(d)
        }
        if (role & Request()) != 0 {
            Requesters.Add(d)
        }
    }
}

// The networks with at least one member, ascending, and the lowest ID not in use (0 when all are).
fn InUse(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, out Nets: array<int>, out NextFree: int) {
    Nets = []
    NextFree = 0
    let used: array<int> = []
    for d in FreightDocks(MapLoad) {
        let u = Unpack(d.activeTradePartnerId)
        for n in u.Nets {
            if n > 0 {
                used.AddUnique(n)
            }
        }
    }
    let n = 1
    while n <= MaxNet() {
        if used.Contains(n) {
            Nets.Add(n)
        } else if NextFree == 0 {
            NextFree = n
        }
        n += 1
    }
}

// The docks this dock supplies: requesters on every network it provides on, itself left out, each once, in dock
// ID order (the order round-robin follows).
fn RequestersOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> array<WorkDock> {
    let out: array<WorkDock> = []
    let u = Unpack(Dock.activeTradePartnerId)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Provide()) != 0 {
            let m = Members(MapLoad, u.Nets[i])
            for r in m.Requesters {
                if r != Dock {
                    out.AddUnique(r)
                }
            }
        }
        i += 1
    }
    SortById(out)
    return out
}

// The docks that supply this dock: providers on every network it requests on, itself left out, each once.
fn ProvidersOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> array<WorkDock> {
    let out: array<WorkDock> = []
    let u = Unpack(Dock.activeTradePartnerId)
    let i = 0
    while i < Slots() {
        if u.Nets[i] > 0 && (u.Roles[i] & Request()) != 0 {
            let m = Members(MapLoad, u.Nets[i])
            for p in m.Providers {
                if p != Dock {
                    out.AddUnique(p)
                }
            }
        }
        i += 1
    }
    SortById(out)
    return out
}

// Converts every 1.x pair (A <-> B) into a network of its own, the lowest free ID, with both docks in the role
// "both"; a 1.x value whose partner is gone becomes -1. Returns the number of networks made. Once converted, a
// save can't be read by mod 1.x.
fn Migrate(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) -> int {
    let made = 0
    let docks = FreightDocks(MapLoad)
    for d in docks {
        let u = Unpack(d.activeTradePartnerId)
        if !u.IsNew && u.OldPartner >= 0 {
            let partner: WorkDock = none
            for p in docks {
                if DockId(p) == u.OldPartner && p != d {
                    partner = p
                }
            }
            if partner == none {
                d.activeTradePartnerId = -1
            } else {
                let free = InUse(MapLoad).NextFree
                if free == 0 {
                    // all 31 networks taken: leave the pair as it is
                    continue
                }
                let both = Both()
                d.activeTradePartnerId = Pack([free], [both], false)
                let pu = Unpack(partner.activeTradePartnerId)
                if pu.IsNew {
                    let w = With(partner.activeTradePartnerId, free, both)
                    partner.activeTradePartnerId = w.ReturnValue
                } else {
                    // the partner's own value (its pair with d, or with another dock) is replaced
                    partner.activeTradePartnerId = Pack([free], [both], false)
                }
                made += 1
            }
        }
    }
    return made
}

// The dock it delivers to: its current destination (NetDest, chosen by ChooseDest) while that is still one of its
// requesters, else its first requester. A dock that only requests gets its first provider (for the panel and arcs).
// A 1.x value gives its old partner, until Migrate has run. none when it has neither.
fn PartnerOf(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> WorkDock {
    if Dock == none {
        return none
    }
    let u = Unpack(Dock.activeTradePartnerId)
    if !u.IsNew {
        if u.OldPartner >= 0 {
            return MapLoad.DockById(u.OldPartner).Dock
        }
        return none
    }
    let r = RequestersOf(MapLoad, Dock)
    if r.Length() > 0 {
        let cur = MapLoad.NetDest.Find(DockId(Dock))
        if cur.ReturnValue {
            for d in r {
                if DockId(d) == cur.Value {
                    return d
                }
            }
        }
        return r[0]
    }
    let p = ProvidersOf(MapLoad, Dock)
    if p.Length() > 0 {
        return p[0]
    }
    return none
}

// Whether Requester wants something Provider can load: a resource its output warehouses lack (beyond what
// is already unloaded at it) that Provider's input warehouses hold, reserved for pickup or not (stock
// haulers have reserved is on its way to the dock). A provider without input warehouses can load nothing.
fn Wants(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Provider: WorkDock, Requester: WorkDock) -> bool {
    let src = SourceStock(MapLoad, Provider, true)
    if !src.HasSources {
        return false
    }
    let want = MapLoad.DeficitsFor(Requester).Want
    for res, deficit in want.counts {
        let s = Requester.m_stockpile_goodsFromSea.Slots.Find(res)
        let atPartner = if s.ReturnValue { s.Value.count } else { 0 }
        let st = src.Stock.Find(res)
        if deficit - atPartner > 0 && st.ReturnValue && st.Value > 0 {
            return true
        }
    }
    return false
}

// Round-robin over a provider's requesters (dock ID order). Called by the loading plan for a berthed dock. While
// goods are on their way to it or aboard, its destination stays; once freight is aboard (LoadingSince), the
// destination is marked used (NetUsed): a trip is under way. Once idle again after a trip, the turn passes to the
// next requester that wants something it can load; while idle, a destination that wants nothing it can load is
// passed on the same way. With none wanting anything, the destination stays. A change replans the route.
fn ChooseDest(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) {
    let id = DockId(Dock)
    let reqs = RequestersOf(MapLoad, Dock)
    let n = reqs.Length()
    if n == 0 {
        MapLoad.NetDest.Remove(id)
        MapLoad.NetUsed.Remove(id)
        return
    }
    let cur = MapLoad.NetDest.Find(id)
    let curIdx = -1
    if cur.ReturnValue {
        let i = 0
        while i < n {
            if DockId(reqs[i]) == cur.Value {
                curIdx = i
            }
            i += 1
        }
    }
    let busy = MapLoad.LoadingSince.Contains(id) || MapLoad.DepartingSince.Contains(id) || MapLoad.Voyages.Contains(id)
    for res, slot in Dock.m_inputStockpile.Slots {
        if slot.count + slot.reservedSpaceForDropoff > 0 {
            busy = true
        }
    }
    // goods aboard that were requested for this trip keep the destination they were loaded for
    let ship = ShipAtDock(MapLoad, Dock)
    if ship != none {
        for res, held in MapLoad.HoldCounts(ship).Counts {
            if held > 0 && MapLoad.Requested.Contains(string(id) + "|" + string(res)) {
                busy = true
            }
        }
    }
    if busy && curIdx >= 0 {
        if MapLoad.LoadingSince.Contains(id) {
            MapLoad.NetUsed[id] = true
        }
        return
    }
    let u = MapLoad.NetUsed.Find(id)
    let used = u.ReturnValue && u.Value
    let start = if curIdx < 0 { 0 } else if used { (curIdx + 1) % n } else { curIdx }
    let pick = -1
    let k = 0
    while k < n && pick < 0 {
        let i = (start + k) % n
        if Wants(MapLoad, Dock, reqs[i]) {
            pick = i
        }
        k += 1
    }
    if pick < 0 {
        pick = if curIdx >= 0 { curIdx } else { 0 }
    }
    MapLoad.NetUsed[id] = false
    let newId = DockId(reqs[pick])
    if !cur.ReturnValue || cur.Value != newId {
        MapLoad.NetDest[id] = newId
        MapLoad.PlanRoute(Dock)
        ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Dock " + string(id) + " now delivers to " + string(newId) + " (" + string(pick + 1) + " of " + string(n) + ")", false)
    }
}

// Where the dock stands in its round-robin: the current destination's place (1-based) and the number of requesters.
fn Turn(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock, out Place: int, out Count: int) {
    let reqs = RequestersOf(MapLoad, Dock)
    Count = reqs.Length()
    Place = 0
    let dest = PartnerOf(MapLoad, Dock)
    let i = 0
    while i < Count {
        if reqs[i] == dest {
            Place = i + 1
        }
        i += 1
    }
}

// The dock leaves every network it is in; the other members stay. Returns whether it was paired.
fn Leave(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) -> bool {
    if Dock == none || !IsPaired(Dock.activeTradePartnerId) {
        return false
    }
    let u = Unpack(Dock.activeTradePartnerId)
    if !u.IsNew {
        Unpair(MapLoad, Dock)
        return true
    }
    Dock.activeTradePartnerId = Emptied(Dock.activeTradePartnerId)
    MapLoad.NetDest.Remove(DockId(Dock))
    return true
}

// Target joins Member's first network as "both". Returns the network, or 0 when Member is in none or Target has no
// free membership.
fn Join(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Member: WorkDock, Target: WorkDock) -> int {
    let u = Unpack(Member.activeTradePartnerId)
    let net = 0
    for n in u.Nets {
        if net == 0 && n > 0 {
            net = n
        }
    }
    if net == 0 {
        return 0
    }
    let w = With(Target.activeTradePartnerId, net, Both())
    if !w.Ok {
        return 0
    }
    Target.activeTradePartnerId = w.ReturnValue
    return net
}

// The value for a dock left in no network: -1, or an empty network value when it keeps "depart only when full".
pure fn Emptied(Stored: int) -> int {
    let u = Unpack(Stored)
    let none4: array<int> = []
    return if u.Full { Pack(none4, none4, true) } else { -1 }
}

// Takes the dock out of every network, and the other members out of those networks too (as unpairing both docks of
// a pair does today). A 1.x pair is cleared on both ends.
fn Unpair(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Dock: WorkDock) {
    if Dock == none {
        return
    }
    let u = Unpack(Dock.activeTradePartnerId)
    if !u.IsNew {
        if u.OldPartner >= 0 {
            let p = MapLoad.DockById(u.OldPartner).Dock
            if p != none {
                p.activeTradePartnerId = -1
            }
        }
        Dock.activeTradePartnerId = -1
        return
    }
    for net in u.Nets {
        if net > 0 {
            for d in FreightDocks(MapLoad) {
                if d != Dock && RoleOn(d.activeTradePartnerId, net) != 0 {
                    let w = With(d.activeTradePartnerId, net, 0)
                    d.activeTradePartnerId = if IsMember(w.ReturnValue) { w.ReturnValue } else { Emptied(w.ReturnValue) }
                }
            }
        }
    }
    Dock.activeTradePartnerId = Emptied(Dock.activeTradePartnerId)
}

// Pairs two docks, as F5 does: both leave their networks, then share the lowest free network, both in the role
// "both". Returns the network, or 0 when all are taken (nothing changes then).
fn Pair(MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, A: WorkDock, B: WorkDock) -> int {
    if A == none || B == none || A == B {
        return 0
    }
    Unpair(MapLoad, A)
    Unpair(MapLoad, B)
    let net = InUse(MapLoad).NextFree
    if net == 0 {
        return 0
    }
    let wa = With(A.activeTradePartnerId, net, Both())
    A.activeTradePartnerId = wa.ReturnValue
    let wb = With(B.activeTradePartnerId, net, Both())
    B.activeTradePartnerId = wb.ReturnValue
    return net
}

// Whether the dock is paired: in a network, or holding a 1.x pair.
pure fn IsPaired(Stored: int) -> bool {
    let u = Unpack(Stored)
    return IsMember(Stored) || u.OldPartner >= 0
}
