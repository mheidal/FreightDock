blueprint WBP_FDPanel : UserWidget at /Game/Mods/FreightDock/UI/WBP_FDPanel

// The Freight Dock panel: while a freight dock is selected, it stands to the left of the dock's window
// (Details_WorkDock_Generic), its foot just above the bottom of the screen, and shows the target, the dock's freight
// networks (Edit opens the network GUI, WBP_FDNetPanel, to its left), the ship, the
// job's manifest (WBP_FDWantRow), the goods waiting at this dock to be unloaded (while there are any),
// the target's output and this dock's input warehouses (links that pan the camera there; input warehouses with
// what they hold), and Deliver now.
// It sits in the game's rounded frame over the dock window's own background, borrows the window's fonts, and
// hides the window's "Load resources onto ship" bar and its supported-actions frames, giving them back their
// visibility when anything else is selected.
// BP_MapLoad creates it once and calls Step every frame (PanelTick).

var MapLoad: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C
var ShownId: int = -1
var NextRefresh: float = 0.0
var RowsKey: string = ""
var TargetRows: array<WBP_FDLinkRow>
var DestRows: array<WBP_FDLinkRow>
var SrcRows: array<WBP_FDLinkRow>
var SrcIds: array<int>
var ManifestRows: array<WBP_FDWantRow>
var Window: Details_WorkDock_Generic
var Kept: array<Widget>
var KeptWas: array<ESlateVisibility>
var KeptOpacity: array<float>
var Spacers: array<SizeBox>
var SpacerMins: array<float>
var HaveFonts: bool = false
var TitleFont: SlateFontInfo
var HeadFont: SlateFontInfo
var BodyFont: SlateFontInfo
var SmallFont: SlateFontInfo
var Placed: int = 0
var ShownAt: float = 0.0
var HaveBrush: bool = false
var Migrated: bool = false
var ShownDock: WorkDock
var Editing: bool = false
var NetPanel: WBP_FDNetPanel
// the network map (WBP_FDMapPanel), opened by Map
var MapPanel: WBP_FDMapPanel
var Mapping: bool = false
// the dock window's background (Sweep), and how far down the window is moved (slate units) so its bottom lines up
// with this panel's; frames to wait for the move to show in its geometry
var WindowBg: Widget
var Lowered: float = 0.0
var LowerWait: int = 0
// the last move measured, applied to a dock window as soon as it shows (before it is laid out, so it doesn't show at
// its usual place first), and the windows moved
var KnownLower: float = 0.0
var Moved: array<Widget>
// BP_MapLoad's tick moved to the end of the frame (Step, once)
var TickLate: bool = false
// frames left to sweep a dock window found before it was laid out (FindWindow)
var SweepSoon: int = 0
// the rename popup (WBP_FDRename, made the first time), and what it renames: a network (RenameNet), else the dock
// Renaming
var Rename: WBP_FDRename
var RenameNet: int = 0
var Renaming: WorkDock
// the NETWORKS entries (one per membership, hoverable) and the highlight last asked for (BPL_FDPairing.Highlight)
var NetEntryBoxes: array<Border>
var NetEntryNets: array<int>
var NetEntryTips: array<WBP_FDMembersTip>
var NetEntriesKey: string = ""
var HiNet: int = 0
var HiKind: int = 0
var HiGood: name
// the camera's zoom target while the cursor is over the network GUI (-1: not held)
var HeldZoom: float = -1.0
var IncomingRows: array<WBP_FDIncomingRow>
// tooltips: Pause's, Deliver now's (why it can't act), the title's (click to rename)
var PauseTip: WBP_FDTip
var PauseOn: soft<Texture2D> = /Game/Assets/Icons/icons8-pause-100.icons8-pause-100
var PlayOn: soft<Texture2D> = /Game/Assets/Icons/icons8-play-100.icons8-play-100
