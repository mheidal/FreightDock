on Construct {
    // The content goes into the game's rounded frame (its named slot); Inner is declared in Stack only because
    // a widget tree has a single root.
    Frame.NamedSlot_93.SetContent(Inner)
    HideFrameIcon()
    PauseTip = create_widget(WBP_FDTip)
    DeliverTip = create_widget(WBP_FDTip)
    TitleTip = create_widget(WBP_FDTip)
    PauseBtn.SetToolTip(PauseTip)
    TitleBtn.SetToolTip(TitleTip)
    PauseIcon.SetDesiredSizeOverride(Vector2D(X: 24.0, Y: 24.0))
    EditTip = create_widget(WBP_FDTip)
    MapTip = create_widget(WBP_FDTip)
    EditRound.SetToolTip(EditTip)
    MapRound.SetToolTip(MapTip)
    IconOnly(EditRound, EditTex.load())
    IconOnly(MapRound, MapTex.load())
    // the route icon looked left of centre in its button (the spyglass, set the same way, didn't): nudged by eye
    EditRound.icon.SetRenderTranslation(Vector2D(X: 2.0, Y: 0.0))
    Labels()
    Deliver.OnClicked.bind(DeliverClicked)
    PauseBtn.OnClicked.bind(PauseClicked)
    EditRound.OnClicked.bind(EditClicked)
    MapRound.OnClicked.bind(MapClicked)
    TitleBtn.OnClicked.bind(TitleClicked)
    KeyC = OptionManager.StringToKey("C")
    KeyV = OptionManager.StringToKey("V")
    KeyZ = OptionManager.StringToKey("Z")
    CtrlL = OptionManager.StringToKey("LeftControl")
    CtrlR = OptionManager.StringToKey("RightControl")
    SetVisibility(ESlateVisibility.Collapsed)
}

// The fixed labels, in the player's language (BPL_FDText); set again on every refresh, so a language change shows.
fn Labels() {
    NetHead.SetText(text(BPL_FDText.T("freightdock.panel.networks")))
    ShipHead.SetText(text(BPL_FDText.T("freightdock.panel.ship")))
    UnloadHead.SetText(text(BPL_FDText.T("freightdock.panel.waitingToUnload")))
    ManifestHead.SetText(text(BPL_FDText.T("freightdock.panel.manifest")))
    IncomingHead.SetText(text(BPL_FDText.T("freightdock.panel.incoming")))
    let paused = false
    if ShownDock != none {
        paused = BPL_FDNet.IsPaused(ShownDock.activeTradePartnerId)
    }
    // pause icon while it works, play icon while paused
    PauseIcon.SetBrushFromTexture(if paused { PlayOn.load() } else { PauseOn.load() }, false)
    PauseIcon.SetColorAndOpacity(LinearColor(R: 0.91, G: 0.78, B: 0.45, A: 1.0))
    PauseTip.Setup(BPL_FDText.T(if paused { "freightdock.panel.resumeTip" } else { "freightdock.panel.pauseTip" }), SmallFont)
    TitleTip.Setup(BPL_FDText.T("freightdock.panel.renameTip"), SmallFont)
    DestHead.SetText(text(BPL_FDText.T("freightdock.panel.targetOutput")))
    SrcHead.SetText(text(BPL_FDText.T("freightdock.panel.thisInput")))
    Deliver.SetLabelText(BPL_FDText.T("freightdock.panel.deliverNow"))
    EditTip.Setup(BPL_FDText.T(if Editing { "freightdock.panel.closeEdit" } else { "freightdock.panel.edit" }), SmallFont)
    MapTip.Setup(BPL_FDText.T(if Mapping { "freightdock.panel.hideMap" } else { "freightdock.panel.map" }), SmallFont)
    ToolLook(EditRound, Editing)
    ToolLook(MapRound, Mapping)
}

// A game round button showing only an icon, centred (the icon's slot loses the gap it keeps for the label).
fn IconOnly(Btn: Arco_Button_CommonRound, Icon: Texture2D) {
    Btn.SetLabelText("")
    Btn.ButtonText.SetVisibility(ESlateVisibility.Collapsed)
    Btn.SetIcon(Icon)
    Btn.icon.SetVisibility(ESlateVisibility.HitTestInvisible)
    Btn.icon.SetDesiredSizeOverride(Vector2D(X: 28.0, Y: 28.0))
    let hs = cast(Btn.icon.Slot, HorizontalBoxSlot)
    if hs != none {
        hs.SetPadding(Margin(Left: 0, Top: 0, Right: 0, Bottom: 0))
        hs.SetHorizontalAlignment(EHorizontalAlignment.HAlign_Center)
    }
    let os = cast(Btn.icon.Slot, OverlaySlot)
    if os != none {
        os.SetPadding(Margin(Left: 0, Top: 0, Right: 0, Bottom: 0))
        os.SetHorizontalAlignment(EHorizontalAlignment.HAlign_Center)
    }
}

// An opaque colour from 0-255 channels.
pure fn Rgb(R: int, G: int, B: int) -> Color {
    return Color(R: KismetMathLibrary.Conv_IntToByte(R), G: KismetMathLibrary.Conv_IntToByte(G), B: KismetMathLibrary.Conv_IntToByte(B), A: KismetMathLibrary.Conv_IntToByte(255))
}

// An icon button's colours (user's scheme): its panel open, light gold icon on near-black with an orange outline;
// closed, dull gold on black with a brown outline.
fn ToolLook(Btn: Arco_Button_CommonRound, Open: bool) {
    let fg = if Open { Rgb(223, 192, 125) } else { Rgb(139, 122, 83) }
    let bg = if Open { Rgb(26, 21, 16) } else { Rgb(0, 0, 0) }
    let line = if Open { Rgb(206, 121, 33) } else { Rgb(132, 95, 74) }
    Btn.SetIconTint(SlateColor(SpecifiedColor: KismetMathLibrary.Conv_ColorToLinearColor(fg)))
    Btn.SetBgTint(bg)
    Btn.CommonRoundedButtonBg.BgFrame.SetColorAndOpacity(KismetMathLibrary.Conv_ColorToLinearColor(line))
}

// A click on the panel's background stays on the panel (press and release), so it doesn't reach the world behind it.
on OnMouseButtonDown(MyGeometry: Geometry, MouseEvent: PointerEvent) -> EventReply {
    return WidgetBlueprintLibrary.Handled()
}

on OnMouseButtonUp(MyGeometry: Geometry, MouseEvent: PointerEvent) -> EventReply {
    return WidgetBlueprintLibrary.Handled()
}

on OnMouseButtonDoubleClick(InMyGeometry: Geometry, InMouseEvent: PointerEvent) -> EventReply {
    return WidgetBlueprintLibrary.Handled()
}

// The rounded frame draws its header icon whatever showIcon says once built: collapse its images showing the
// frame's Icon texture.
fn HideFrameIcon() {
    if Frame.Icon == none {
        return
    }
    let parts: array<Image> = [Frame.Image, Frame.Image_1, Frame.Image_125, Frame.Image_42, Frame.Image_85]
    for img in parts {
        if img != none {
            if img.Brush.ResourceObject == Frame.Icon {
                img.SetVisibility(ESlateVisibility.Collapsed)
            }
        }
    }
}

// Opens or closes the network GUI (WBP_FDNetPanel), made the first time.
fn EditClicked() {
    Editing = !Editing
    Labels()
    if Editing && NetPanel == none {
        NetPanel = create_widget(WBP_FDNetPanel)
        NetPanel.AddToViewport(0)
        NetPanel.Changed.bind(NetChanged)
        NetPanel.RenameAsked.bind(NetRenameAsked)
    }
    if !Editing {
        CloseRename()
    }
    NextRefresh = 0.0
}

// Opens or closes the network map (WBP_FDMapPanel), made the first time.
fn MapClicked() {
    Mapping = !Mapping
    Labels()
    if Mapping && MapPanel == none {
        MapPanel = create_widget(WBP_FDMapPanel)
        MapPanel.AddToViewport(0)
    }
    if Mapping {
        if HaveBrush && HaveFonts {
            MapPanel.SetLook(Bg.Brush, Bg.ColorAndOpacity, BodyFont, SmallFont)
        }
        MapPanel.Open(MapLoad, ShownDock)
    }
    NextRefresh = 0.0
}

// The network GUI changed a membership: show it here at once.
fn NetChanged() {
    NextRefresh = 0.0
    RowsKey = ""
}

fn DeliverClicked() {
    if MapLoad != none {
        MapLoad.DeliverSelected()
    }
    // show the result (leaving, or waiting for the goods being carried) at once
    NextRefresh = 0.0
}

// The title: the rename popup over it, starting with the dock's name (empty while it has none).
fn TitleClicked() {
    if ShownDock == none {
        return
    }
    let initial = if BPL_FDNet.IsNamed(ShownDock) { BPL_FDNet.DockName(MapLoad, ShownDock) } else { "" }
    let g = TitleBtn.GetCachedGeometry()
    let middle = KismetMathLibrary.Multiply_Vector2DFloat(SlateBlueprintLibrary.GetLocalSize(g), 0.5)
    OpenRename(0, ShownDock, BPL_FDText.T("freightdock.rename.dock"), initial, BPL_FDText.T1("freightdock.dock.unnamed", "id", string(DockId(ShownDock))), SlateBlueprintLibrary.LocalToViewport(g, middle).PixelPosition)
}

// A network's ID in the network GUI: the rename popup over it.
fn NetRenameAsked(Net: int, Name: string, At: Vector2D) {
    OpenRename(Net, none, BPL_FDText.T1("freightdock.rename.net", "net", string(Net)), Name, "", At)
}

fn OpenRename(Net: int, Dock: WorkDock, Title: string, Initial: string, Hint: string, At: Vector2D) {
    if Rename == none {
        Rename = create_widget(WBP_FDRename)
        // above the game's own windows, the dock window among them
        Rename.AddToViewport(1000)
        Rename.Done.bind(RenameDone)
    }
    RenameNet = Net
    Renaming = Dock
    Rename.Open(Title, Initial, Hint, At, BodyFont)
}

// The popup's text: the network's or the dock's new name ("": unnamed again).
fn RenameDone(Name: string) {
    if RenameNet > 0 {
        if NetPanel != none {
            NetPanel.NetRenamed(RenameNet, Name)
        }
    } else if Renaming != none {
        BPL_FDNet.SetDockName(Renaming, Name)
    }
    RenameNet = 0
    Renaming = none
    NextRefresh = 0.0
    RowsKey = ""
    NetEntriesKey = ""
}

// Shuts the popup without keeping what was typed (the dock deselected or the network GUI closed).
fn CloseRename() {
    if Rename != none {
        Rename.Close()
    }
    RenameNet = 0
    Renaming = none
}

// Ctrl+C on a freight dock copies its networks; on anything else, it drops the copy, as the game's copy then holds
// something else. Ctrl+V on a freight dock pastes them (its pause stays), Ctrl+Z undoes that paste while the dock is
// still shown. Each says so in a toast. Not while the rename popup takes the keys. Shown: a freight dock is shown.
fn CopyKeys(Shown: bool) {
    let pc = GameplayStatics.GetPlayerController(0)
    if pc == none || MapLoad == none {
        return
    }
    if Rename != none {
        if Rename.Showing {
            return
        }
    }
    let ctrl = pc.IsInputKeyDown(CtrlL)
    if !ctrl {
        ctrl = pc.IsInputKeyDown(CtrlR)
    }
    if !ctrl {
        return
    }
    if pc.WasInputKeyJustPressed(KeyC) {
        HasCopy = Shown
        if Shown {
            Copied = ShownDock.activeTradePartnerId
            MapLoad.Toast(BPL_FDText.T1("freightdock.copy.copied", "nets", NetList(Copied)))
        }
    }
    if !Shown {
        return
    }
    let id = DockId(ShownDock)
    if pc.WasInputKeyJustPressed(KeyV) {
        if HasCopy {
            UndoDock = id
            UndoValue = ShownDock.activeTradePartnerId
            SetNets(Copied)
            MapLoad.Toast(BPL_FDText.T1("freightdock.copy.pasted", "nets", NetList(Copied)))
        }
    }
    if pc.WasInputKeyJustPressed(KeyZ) {
        if UndoDock == id {
            UndoDock = -1
            SetNets(UndoValue)
            MapLoad.Toast(BPL_FDText.T("freightdock.copy.undone"))
        }
    }
}

// The shown dock's memberships set to Value's, its pause kept; both GUIs show it at once.
fn SetNets(Value: int) {
    let v = BPL_FDNet.WithPaused(Value, BPL_FDNet.IsPaused(ShownDock.activeTradePartnerId))
    ShownDock.activeTradePartnerId = if BPL_FDNet.IsMember(v) { v } else { BPL_FDNet.Emptied(v) }
    NextRefresh = 0.0
    RowsKey = ""
    NetEntriesKey = ""
}

// A stored value's memberships as text ("1 Food: provide, 3: both"), or "Not in a network".
fn NetList(Stored: int) -> string {
    let roles: array<string> = ["", BPL_FDText.T("freightdock.role.provide"), BPL_FDText.T("freightdock.role.request"), BPL_FDText.T("freightdock.role.both")]
    let netNames = BPL_FDNet.NetNames(MapLoad)
    let u = BPL_FDNet.Unpack(Stored)
    let parts: array<string> = []
    let i = 0
    while i < BPL_FDNet.Slots() {
        if u.Nets[i] > 0 {
            parts.Add(BPL_FDText.T2("freightdock.panel.membership", "net", BPL_FDNet.NetLabel(u.Nets[i], netNames), "role", roles[u.Roles[i]]))
        }
        i += 1
    }
    return if parts.Length() == 0 { BPL_FDText.T("freightdock.panel.notInNetwork") } else { KismetStringLibrary.JoinStringArray(parts, ", ") }
}

// Pause / Resume: the ship finishes its job, then takes no new one (BPL_FDDispatch skips a paused dock).
fn PauseClicked() {
    if MapLoad == none || ShownDock == none {
        return
    }
    let paused = !BPL_FDNet.IsPaused(ShownDock.activeTradePartnerId)
    ShownDock.activeTradePartnerId = BPL_FDNet.WithPaused(ShownDock.activeTradePartnerId, paused)
    NextRefresh = 0.0
}

// Development only (unhooked; see ProbeAt): every 0.1 s of game time, per dock and per
// category, a line when that category changes - state (pause, duty, job and manifest, idle reason, the loading,
// departing, voyage and stall records), requests (dock-specific, live), input slot, delivered-goods store, repair
// store, hold (exact quantities), plan (stall clocks per good), workers (here or away, what each is doing and
// carrying), warehouses (this dock's input and output warehouses, for the goods in play) and target (its unmet
// requests and delivered-goods store for the manifest).
fn ProbeIdle(Owner: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    let now = GameplayStatics.GetTimeSeconds()
    if now < IdleProbeAt {
        return
    }
    IdleProbeAt = now + 0.1
    for d in BPL_FDNet.FreightDocks(Owner) {
        ProbeDock(Owner, d)
    }
}

// Logs Text as the dock's Cat line when it differs from the last one.
fn ProbeLog(Owner: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Id: int, Cat: string, Text: string) {
    let key = string(Id) + "|" + Cat
    let was = ProbeSeen.Find(key)
    let before = if was.ReturnValue { was.Value } else { "" }
    if Text != before {
        ProbeSeen[key] = Text
        // game time, for the order of changes within a second
        BPL_FDDispatch.Log(Owner, "Probe: t " + string(GameplayStatics.GetTimeSeconds()) + " dock " + string(Id) + " " + Cat + ":" + (if Text == "" { " none" } else { Text }))
    }
}

// Every slot with anything in it: count / capacity, dropoff and pickup reservations, minimum hold.
pure fn SlotText(Pile: Stockpile) -> string {
    let out = ""
    for res, s in Pile.Slots {
        if s.count != 0 || s.capacity != 0 || s.reservedForPickup != 0 || s.reservedSpaceForDropoff != 0 || s.minHold != 0 {
            out += " " + string(res) + "=" + string(s.count) + "/" + string(s.capacity) + " drop " + string(s.reservedSpaceForDropoff) + " res " + string(s.reservedForPickup) + (if s.minHold != 0 { " min " + string(s.minHold) } else { "" })
        }
    }
    return out
}

// A warehouse's slots for Goods (Kind: "in" or "out").
fn WarehouseText(Owner: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, Kind: string, Bid: int, Goods: array<name>) -> string {
    let head = " | " + Kind + " " + string(Bid)
    let b = Owner.BuildingById(Bid).Building
    if b == none {
        return head + " gone"
    }
    let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
    if rb == none {
        return head + " not a store"
    }
    let out = head + (if rb.m_forceEmpty { " keep-empty" } else { "" }) + ":"
    for res in Goods {
        let s = rb.m_stockpile.Slots.Find(res)
        if s.ReturnValue {
            out += " " + string(res) + "=" + string(s.Value.count) + " res " + string(s.Value.reservedForPickup) + " drop " + string(s.Value.reservedSpaceForDropoff) + " min " + string(s.Value.minHold)
        }
    }
    return out
}

fn ProbeDock(Owner: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C, D: WorkDock) {
    let id = DockId(D)
    let goods: array<name> = []

    let st = if BPL_FDNet.IsPaused(D.activeTradePartnerId) { " paused" } else { " active" }
    st += " stored " + string(D.activeTradePartnerId) + " onDuty " + string(BPL_FDNet.OnDuty(Owner, D))
    let job = Owner.JobTo.Find(id)
    if job.ReturnValue {
        st += " job->" + string(job.Value)
        for res, n in BPL_FDNet.Manifest(Owner, id) {
            st += " " + string(res) + "=" + string(n)
            goods.AddUnique(res)
        }
    } else {
        let why = Owner.IdleWhy.Find(id)
        st += " no job (" + (if why.ReturnValue { why.Value } else { "" }) + ")"
    }
    let ls = Owner.LoadingSince.Find(id)
    if ls.ReturnValue {
        st += " loadingSince " + string(ls.Value)
    }
    let ds = Owner.DepartingSince.Find(id)
    if ds.ReturnValue {
        st += " departingSince " + string(ds.Value)
    }
    let da = Owner.DepartedAt.Find(id)
    if da.ReturnValue {
        st += " departedAt " + string(da.Value)
    }
    if Owner.Voyages.Contains(id) {
        let ph = Owner.VoyagePhase.Find(id)
        st += " voyage phase " + (if ph.ReturnValue { string(ph.Value) } else { "?" })
    }
    let sailed = Owner.JobSailed.Find(id)
    if sailed.ReturnValue {
        st += " sailed " + string(sailed.Value)
    }
    let dropped = Owner.JobDropped.Find(id)
    if dropped.ReturnValue {
        st += " dropped " + dropped.Value
    }
    ProbeLog(Owner, id, "state", st)

    let rq = ""
    for res, n in D.m_requiredEmbarkSupplies_dockSpecific.counts {
        rq += " spec " + string(res) + "=" + string(n)
    }
    for res, n in D.m_requiredEmbarkSupplies_live.counts {
        rq += " live " + string(res) + "=" + string(n)
    }
    ProbeLog(Owner, id, "requests", rq)

    for res, s in D.m_inputStockpile.Slots {
        if s.count != 0 || s.capacity != 0 {
            goods.AddUnique(res)
        }
    }
    for res, s in D.m_stockpile_goodsFromSea.Slots {
        if s.count != 0 {
            goods.AddUnique(res)
        }
    }
    ProbeLog(Owner, id, "input", SlotText(D.m_inputStockpile))
    ProbeLog(Owner, id, "store", SlotText(D.m_stockpile_goodsFromSea))
    ProbeLog(Owner, id, "repair", SlotText(D.m_repairStockpile))

    let ship = BPL_FDNet.ShipAtDock(Owner, D)
    let hd = ""
    if ship == none {
        hd = " no ship at dock"
    } else {
        for res, item in ship.State.cargo.Items {
            hd += " " + string(res) + "=" + string(item.Quantity)
            goods.AddUnique(res)
        }
        hd += " (limit " + string(ship.config.cargoLimit) + ")"
    }
    ProbeLog(Owner, id, "hold", hd)

    let linker = cast(D.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    // without a job, every good its input warehouses hold (what the dispatcher could offer)
    if !job.ReturnValue && linker != none {
        for bid in linker.m_sourceStockpileIds {
            let b = Owner.BuildingById(bid).Building
            if b != none {
                let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
                if rb != none {
                    for res, s in rb.m_stockpile.Slots {
                        if s.count > 0 {
                            goods.AddUnique(res)
                        }
                    }
                }
            }
        }
    }

    let pl = ""
    let prefix = string(id) + "|"
    for key, at in Owner.CutStock {
        if KismetStringLibrary.StartsWith(key, prefix, ESearchCase.CaseSensitive) {
            pl += " barred " + KismetStringLibrary.RightChop(key, KismetStringLibrary.Len(prefix)) + " until stock != " + string(at)
        }
    }
    for res in goods {
        let k = BPL_FDNet.JobKey(id, res)
        let seen = Owner.PickupSeen.Find(k)
        let since = Owner.PickupSince.Find(k)
        if seen.ReturnValue || since.ReturnValue {
            pl += " " + string(res) + ": seen " + (if seen.ReturnValue { string(seen.Value) } else { "-" }) + " since " + (if since.ReturnValue { string(since.Value) } else { "-" })
        }
    }
    ProbeLog(Owner, id, "plan", pl)

    let wk = ""
    let i = 0
    for slot in D.m_workers.m_workerSlots {
        wk += " [" + string(i) + (if slot.present { " here" } else { " away" })
        if slot.Agent != none {
            wk += " '" + slot.Agent.m_state.currentActionDesc + "'"
            for res, n in slot.Agent.m_currentlyRenderedResources.counts {
                if n > 0 {
                    wk += " carries " + string(res) + "=" + string(n)
                }
            }
        } else {
            wk += " nobody"
        }
        wk += "]"
        i += 1
    }
    ProbeLog(Owner, id, "workers", wk)

    let wh = ""
    if linker != none {
        for bid in linker.m_sourceStockpileIds {
            wh += WarehouseText(Owner, "in", bid, goods)
        }
        for bid in linker.m_destStockpileIds {
            wh += WarehouseText(Owner, "out", bid, goods)
        }
    }
    ProbeLog(Owner, id, "warehouses", wh)

    let tg = ""
    if job.ReturnValue {
        let r = BPL_FDNet.DockIn(Owner, job.Value)
        if r != none {
            let want = Owner.DeficitsFor(r).Want.counts
            for res in goods {
                let w = want.Find(res)
                let at = r.m_stockpile_goodsFromSea.Slots.Find(res)
                tg += " " + string(res) + " wants " + (if w.ReturnValue { string(w.Value) } else { "0" }) + " store " + (if at.ReturnValue { string(at.Value.count) } else { "0" })
            }
        }
    }
    ProbeLog(Owner, id, "target", tg)
}

// Every frame, from BP_MapLoad.PanelTick.
fn Step(Owner: /Game/Mods/FreightDock/BP_MapLoad.BP_MapLoad_C) {
    MapLoad = Owner
    if !TickLate {
        // BP_MapLoad ticks after the game's input and the rest of the world, so a dock window the game shows this
        // frame is found (and moved, LowerWindow) before it is drawn
        TickLate = true
        Owner.SetTickGroup(ETickingGroup.TG_PostUpdateWork)
    }
    if !Migrated && Owner.Docks.Length() > 0 {
        // once per load, when the docks are known: 1.x pairs become networks (BPL_FDNet), and the colony records this
        // version as the last to run on it (BPL_FDStore, "ver"; none before 2026-11)
        Migrated = true
        let made = BPL_FDNet.Migrate(Owner)
        let was = BPL_FDStore.Get("ver")
        BPL_FDStore.Set("ver", BPL_FDStore.Version())
        ModAPI.GetModAPI().LogMessage(Owner.Stamp().Result + "Network storage: " + string(made) + " 1.x pair(s) converted; colony data from version " + (if was == "" { "none" } else { was }), false)
    }
    let found = Owner.FindDockUnderCursor()
    let dock = found.Dock
    let show = false
    if dock != none {
        show = Owner.IsFreightDock(dock).Result
    }
    ShownDock = if show { dock } else { none }
    CopyKeys(show)
    if !show {
        if ShownId != -1 {
            Leave()
        }
        return
    }
    let id = DockId(dock)
    let now = GameplayStatics.GetRealTimeSeconds()
    if id != ShownId {
        // a paste is undone only while its dock is still shown
        UndoDock = -1
        Restore()
        ShownId = id
        NextRefresh = 0.0
        RowsKey = ""
        Placed = 0
        ShownAt = now
        // Laid out but not drawn until it has been placed, so it doesn't jump into place.
        SetVisibility(ESlateVisibility.Hidden)
    }
    KeepHidden()
    let wasFound = Window != none
    FindWindow()
    if SweepSoon > 0 && Window != none {
        SweepSoon -= 1
        Sweep()
    }
    if now >= NextRefresh {
        NextRefresh = now + 0.5
        Refresh(dock)
        if wasFound {
            Sweep()
        }
    }
    Place()
    if Window != none {
        Placed += 1
    }
    if GetVisibility() == ESlateVisibility.Hidden {
        if Placed >= 2 || now > ShownAt + 1.0 {
            SetVisibility(ESlateVisibility.Visible)
        }
    }
    ShowNetPanel()
    HoverStep()
    ShowMapPanel()
    if Mapping && MapPanel != none {
        // the hovered network (HoverStep), else all of the dock's
        MapPanel.Update(MapLoad, ShownDock, HiNet)
    }
    HoldZoom()
}

// The game zooms on the mouse wheel through its own input, which only its own UI can stop: while the cursor is
// over the network GUI (whose table scrolls), its zoom target is held where it was.
fn HoldZoom() {
    let pawn = cast(GameplayStatics.GetPlayerPawn(0), Pawn_Play)
    if pawn == none {
        return
    }
    let over = false
    if NetPanel != none {
        over = NetPanel.IsVisible() && NetPanel.IsHovered()
    }
    if MapPanel != none {
        if MapPanel.IsVisible() && MapPanel.IsHovered() {
            over = true
        }
    }
    if !over {
        HeldZoom = -1.0
        return
    }
    if HeldZoom < 0.0 {
        HeldZoom = pawn.m_desiredZoomDist
    }
    pawn.m_desiredZoomDist = HeldZoom
}

// The network GUI is shown while editing and this panel is drawn.
fn ShowNetPanel() {
    if NetPanel == none {
        return
    }
    let shown = Editing && GetVisibility() == ESlateVisibility.Visible
    NetPanel.SetVisibility(if shown { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
}

// The network map is shown while open and this panel is drawn.
fn ShowMapPanel() {
    if MapPanel == none {
        return
    }
    let shown = Mapping && GetVisibility() == ESlateVisibility.Visible
    MapPanel.SetVisibility(if shown { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
}

// Nothing to show: hide, and give the dock window's parts back their visibility.
fn Leave() {
    if Editing && MapLoad != none {
        // what the game selects instead: nothing (a click reached the world) or another building
        let now = "nothing"
        let tool = cast(GameplayStatics.GetActorOfClass(SelectTool), SelectTool)
        if tool != none {
            if tool.m_currentlySelectedGridActor != none {
                now = KismetSystemLibrary.GetDisplayName(tool.m_currentlySelectedGridActor)
            }
        }
        ModAPI.GetModAPI().LogMessage(MapLoad.Stamp().Result + "Network GUI closed: dock " + string(ShownId) + " no longer selected; selected now: " + now, false)
    }
    ShownId = -1
    UndoDock = -1
    CloseRename()
    SetVisibility(ESlateVisibility.Collapsed)
    if Editing {
        EditClicked()
    }
    if Mapping {
        MapClicked()
    }
    ShowNetPanel()
    ShowMapPanel()
    // hidden: no highlight
    HoverStep()
    Restore()
}

fn Restore() {
    let i = Kept.Length() - 1
    while i >= 0 {
        let w = Kept[i]
        if KismetSystemLibrary.IsValid(w) {
            w.SetVisibility(KeptWas[i])
            w.SetRenderOpacity(KeptOpacity[i])
        }
        i -= 1
    }
    Kept = []
    KeptWas = []
    KeptOpacity = []
    i = 0
    while i < Spacers.Length() {
        if KismetSystemLibrary.IsValid(Spacers[i]) {
            Spacers[i].SetMinDesiredHeight(SpacerMins[i])
        }
        i += 1
    }
    Spacers = []
    SpacerMins = []
    if Window != none && !Moved.Contains(Window) {
        Moved.Add(Window)
    }
    for mw in Moved {
        if KismetSystemLibrary.IsValid(mw) {
            mw.SetRenderTranslation(Vector2D(X: 0.0, Y: 0.0))
        }
    }
    Moved = []
    Lowered = 0.0
    LowerWait = 0
    WindowBg = none
    Window = none
}

// Collapses a part of the dock window, remembering how it was shown.
fn Keep(Part: Widget) {
    if Part == none {
        return
    }
    if Kept.Contains(Part) {
        return
    }
    Kept.Add(Part)
    KeptWas.Add(Part.GetVisibility())
    // the game re-shows some parts every frame (a dock without a ship: "Supported Actions"), which would flicker;
    // it never resets their opacity, so they stay unseen
    KeptOpacity.Add(Part.GetRenderOpacity())
    Part.SetRenderOpacity(0.0)
    Part.SetVisibility(ESlateVisibility.Collapsed)
}

// The game may show them again as it updates the window: collapse them every frame.
fn KeepHidden() {
    for w in Kept {
        if KismetSystemLibrary.IsValid(w) {
            if w.GetVisibility() != ESlateVisibility.Collapsed {
                w.SetVisibility(ESlateVisibility.Collapsed)
            }
        }
    }
}

// The open dock window; when found, its parts to hide and its fonts.
fn FindWindow() {
    if Window != none {
        if KismetSystemLibrary.IsValid(Window) {
            if Window.IsVisible() {
                return
            }
        }
    }
    Window = none
    // a visible window not laid out yet (its first frame): taken when no laid-out one is visible, so its parts are
    // hidden before it is first drawn; Step sweeps it again once laid out (SweepSoon)
    let fresh: Details_WorkDock_Generic = none
    let found = WidgetBlueprintLibrary.GetAllWidgetsOfClass(/Game/UI/GridActor_DetailViews/Details_WorkDock_Generic.Details_WorkDock_Generic_C, false)
    for w in found.FoundWidgets {
        let win = cast(w, Details_WorkDock_Generic)
        if win != none {
            if win.IsVisible() {
                if KnownLower != 0.0 && !Moved.Contains(win) {
                    win.SetRenderTranslation(Vector2D(X: 0.0, Y: KnownLower))
                    Moved.Add(win)
                }
                if SlateBlueprintLibrary.GetAbsoluteSize(win.Tabs_Parent.GetCachedGeometry()).X > 50.0 {
                    Window = win
                } else {
                    fresh = win
                }
            }
        }
    }
    if Window == none {
        if fresh == none {
            return
        }
        Window = fresh
        SweepSoon = 3
    }
    if Moved.Contains(Window) {
        Lowered = KnownLower
        LowerWait = 2
    }
    Keep(Window.ShipPreparationWidget)
    Keep(Window.EmbarkationPanel)
    Unstretch()
    Keep(Window.supportedActions)
    Keep(Window.supportedActions_1)
    Keep(Window.SupportedNauticalActionsHint_Arco)
    Keep(Window.SupportedNauticalActionsHint_Arco_Horizontal)
    if !HaveFonts {
        TakeFonts()
    }
    Sweep()
}

// The departure checklist's frames keep their height with Size Boxes that have a minimum height (one beside the
// ship frame's content, one around the ship frame, which sits at its bottom); without the checklist they leave a
// gap. Clears every such minimum from the checklist up to the window's tabs, stepping out of nested widgets
// (root -> WidgetTree -> UserWidget), remembering each for Restore.
fn Unstretch() {
    let w: Widget = Window.EmbarkationDetails
    let depth = 0
    while w != none && w != Window.Tabs_Parent && depth < 20 {
        let p: Widget = w.GetParent()
        if p != none {
            for c in cast(p, PanelWidget).GetAllChildren() {
                let sb = cast(c, SizeBox)
                if sb != none {
                    if sb.MinDesiredHeight > 0.0 && !Spacers.Contains(sb) {
                        Spacers.Add(sb)
                        SpacerMins.Add(sb.MinDesiredHeight)
                        sb.ClearMinDesiredHeight()
                    }
                }
            }
        } else {
            p = cast(KismetSystemLibrary.GetOuterObject(KismetSystemLibrary.GetOuterObject(w)), Widget)
        }
        w = p
        depth += 1
    }
}

// The topmost parent of a widget within its own widget tree.
fn TopOf(W: Widget) -> Widget {
    let cur = W
    let up = W.GetParent()
    while up != none {
        cur = up
        up = up.GetParent()
    }
    return cur
}

pure fn PosOf(W: Widget) -> Vector2D {
    return SlateBlueprintLibrary.LocalToViewport(W.GetCachedGeometry(), Vector2D(X: 0.0, Y: 0.0)).PixelPosition
}

pure fn SizeOf(W: Widget) -> Vector2D {
    return SlateBlueprintLibrary.GetAbsoluteSize(W.GetCachedGeometry())
}

// Walks the dock window's tree and the tree holding ShipPreparationWidget (the window puts it in a nested
// widget's slot). Collapses the images, borders and ShipPreparationWidget's containers that lie wholly left of
// the window: the bar it sat in, with its background. The first time, copies the window's own background (the
// largest image or border behind its tabs; else the bar's) onto the panel's Bg.
fn Sweep() {
    let view = WidgetLayoutLibrary.GetViewportSize()
    let left = WindowLeft(view.X)
    let chain: array<Widget> = []
    let up = Window.ShipPreparationWidget.GetParent()
    while up != none {
        chain.Add(up)
        up = up.GetParent()
    }
    let all: array<Widget> = [TopOf(Window.Tabs_Parent)]
    let other = TopOf(Window.ShipPreparationWidget)
    if !all.Contains(other) {
        all.Add(other)
    }
    let tabs = PosOf(Window.Tabs_Parent)
    let behind: Widget = none
    let behindArea = 0.0
    let bar: Widget = none
    let barArea = 0.0
    let i = 0
    while i < all.Length() {
        let w = all[i]
        i += 1
        let panel = cast(w, PanelWidget)
        if panel != none {
            for c in panel.GetAllChildren() {
                all.Add(c)
            }
        }
        let isBg = cast(w, Image) != none
        if !isBg {
            isBg = cast(w, Border) != none
        }
        let consider = isBg
        if !consider {
            consider = chain.Contains(w)
        }
        if consider {
            consider = w.IsVisible()
        }
        if consider {
            let p = PosOf(w)
            let z = SizeOf(w)
            let area = z.X * z.Y
            let leftOf = z.X > 100.0 && z.X < view.X * 0.9
            if leftOf {
                leftOf = p.X + z.X <= left + 20.0
            }
            if leftOf {
                if isBg && area > barArea {
                    bar = w
                    barArea = area
                }
                Keep(w)
            } else if isBg && z.X < view.X * 0.6 {
                let covers = p.X <= tabs.X + 1.0 && p.Y <= tabs.Y + 1.0
                if covers {
                    covers = p.X + z.X >= tabs.X && p.Y + z.Y >= tabs.Y
                }
                if covers && area > behindArea {
                    behind = w
                    behindArea = area
                }
            }
        }
    }
    if behind != none {
        WindowBg = behind
    }
    if !HaveBrush {
        let src = if behind == none { bar } else { behind }
        if src != none {
            CopyBrush(src)
        }
    }
}

// The panel's background takes the brush and tint of an image or border of the dock window.
fn CopyBrush(Src: Widget) {
    let img = cast(Src, Image)
    if img != none {
        Bg.SetBrush(img.Brush)
        Bg.SetColorAndOpacity(img.ColorAndOpacity)
    }
    let bor = cast(Src, Border)
    if bor != none {
        Bg.SetBrush(bor.Background)
        Bg.SetColorAndOpacity(bor.BrushColor)
    }
    HaveBrush = true
}

// Left edge (viewport pixels) of the widest parent of the window's tabs that is narrower than half the screen.
fn WindowLeft(ViewWidth: float) -> float {
    let geo = Window.Tabs_Parent.GetCachedGeometry()
    let best = SlateBlueprintLibrary.LocalToViewport(geo, Vector2D(X: 0.0, Y: 0.0)).PixelPosition.X
    let p = Window.Tabs_Parent.GetParent()
    while p != none {
        let g = p.GetCachedGeometry()
        let width = SlateBlueprintLibrary.GetAbsoluteSize(g).X
        if width > 50.0 && width < ViewWidth * 0.5 {
            best = SlateBlueprintLibrary.LocalToViewport(g, Vector2D(X: 0.0, Y: 0.0)).PixelPosition.X
        }
        p = p.GetParent()
    }
    return best
}

// The dock window's own fonts, at the panel's sizes; texts and rows restyled with them.
fn TakeFonts() {
    TitleFont = Sized(Window.ShipName_2.Font, 21.0)
    HeadFont = Sized(Window.ShipStateKey.Font, 17.0)
    BodyFont = Sized(Window.capacity_count.Font, 16.0)
    SmallFont = Sized(Window.capacity_count.Font, 14.0)
    HaveFonts = true
    Title.SetFont(TitleFont)
    ShipHead.SetFont(HeadFont)
    IncomingHead.SetFont(HeadFont)
    DroppedText.SetFont(SmallFont)
    UnloadHead.SetFont(HeadFont)
    NetHead.SetFont(HeadFont)
    NetSummary.SetFont(BodyFont)
    ManifestHead.SetFont(HeadFont)
    DestHead.SetFont(HeadFont)
    SrcHead.SetFont(HeadFont)
    ShipText.SetFont(BodyFont)
    RowsKey = ""
    // the NETWORKS labels are made with the font they have then: make them again
    NetEntriesKey = ""
}

pure fn Sized(Font: SlateFontInfo, Size: float) -> SlateFontInfo {
    let f = Font
    f.Size = Size
    return f
}

pure fn DockId(Dock: WorkDock) -> int {
    let grid = cast(Dock.GetOwner(), GridActor)
    return if grid == none { -1 } else { grid.ID }
}

// Bottom right corner of the panel at the dock window's left edge, 8 px above the bottom of the screen; the dock
// window moved down to the same line.
fn Place() {
    let size = WidgetLayoutLibrary.GetViewportSize()
    LowerWindow(size)
    let left = if Window == none { size.X * 0.64 } else { WindowLeft(size.X) }
    SetAlignmentInViewport(Vector2D(X: 1.0, Y: 1.0))
    SetPositionInViewport(Vector2D(X: left - 6.0, Y: size.Y - 8.0), true)
    if Editing && NetPanel != none {
        // the network GUI to this panel's left, 8 px apart, bottoms aligned
        NetPanel.Place(PosOf(Width).X - 8.0, size.Y - 8.0)
    }
    if Mapping && MapPanel != none {
        // the map above the dock window, right edges aligned, as large as fits between it and the top of the screen
        if WindowBg != none {
            let at = PosOf(WindowBg)
            let wide = SizeOf(WindowBg)
            MapPanel.Place(at.X + wide.X, at.Y - 8.0, wide.X, at.Y - 16.0)
        } else {
            MapPanel.Place(size.X - 8.0, size.Y * 0.5, size.X * 0.3, size.Y * 0.5 - 16.0)
        }
    }
}

// Moves the dock window down so its background's bottom is 8 px above the bottom of the screen (Restore moves it
// back). Its geometry shows a move a frame or two late: waits that long before measuring again.
fn LowerWindow(View: Vector2D) {
    if Window == none || WindowBg == none {
        return
    }
    if LowerWait > 0 {
        LowerWait -= 1
        return
    }
    let gap = View.Y - 8.0 - (PosOf(WindowBg).Y + SizeOf(WindowBg).Y)
    if KismetMathLibrary.Abs(gap) < 1.0 {
        return
    }
    Lowered += gap / WidgetLayoutLibrary.GetViewportScale()
    Window.SetRenderTranslation(Vector2D(X: 0.0, Y: Lowered))
    LowerWait = 2
    KnownLower = Lowered
    if !Moved.Contains(Window) {
        Moved.Add(Window)
    }
}

// Seconds as "m:ss".
pure fn Clock(Seconds: int) -> string {
    let s = Seconds % 60
    return string(Seconds / 60) + ":" + (if s < 10 { "0" } else { "" }) + string(s)
}

// "Medium warehouse" for a medium_warehouse building.
fn BuildingName(Building: Actor) -> string {
    let raw = KismetSystemLibrary.GetClassDisplayName(GameplayStatics.GetObjectClass(Building))
    if KismetStringLibrary.EndsWith(raw, "_C", ESearchCase.CaseSensitive) {
        raw = KismetStringLibrary.LeftChop(raw, 2)
    }
    raw = KismetStringLibrary.Replace(raw, "_", " ", ESearchCase.CaseSensitive)
    return KismetStringLibrary.ToUpper(KismetStringLibrary.Left(raw, 1)) + KismetStringLibrary.RightChop(raw, 1)
}

fn Refresh(Dock: WorkDock) {
    let id = DockId(Dock)
    let target = MapLoad.TargetOf(Dock).Target
    let pid = if target == none { -1 } else { DockId(target) }
    Labels()
    let dockName = BPL_FDNet.DockName(MapLoad, Dock)
    Title.SetText(text(KismetStringLibrary.ToUpper(dockName)))

    let destIds: array<int> = []
    if target != none {
        let plinker = cast(target.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
        if plinker != none {
            for d in plinker.m_destStockpileIds {
                destIds.Add(d)
            }
        }
    }
    let srcIds: array<int> = []
    let linker = cast(Dock.GetOwner().GetComponentByClass(StockpileLinker), StockpileLinker)
    if linker != none {
        for s in linker.m_sourceStockpileIds {
            srcIds.Add(s)
        }
    }
    // the job, shown in the ship section: where the ship delivers
    let caption = if target == none { "" } else { BPL_FDText.T1("freightdock.ship.deliveryTo", "dock", BPL_FDNet.DockName(MapLoad, target)) }
    let provides = BPL_FDNet.RequestersOf(MapLoad, Dock).Length() > 0
    let key = caption + "|"
    for d in destIds {
        key += string(d) + ","
    }
    key += "|"
    for s in srcIds {
        key += string(s) + ","
    }
    if key != RowsKey {
        RowsKey = key
        BuildRows(target, caption, destIds, srcIds)
    }

    let line = ShipLine(Dock, id, target != none)
    if target == none {
        // no job: why the ship is idle (ShipLine then has only the hold, or nothing without a ship)
        let why = MapLoad.IdleWhy.Find(id)
        let idle = if !provides { BPL_FDText.T1("freightdock.ship.idleWhy", "why", BPL_FDText.T("freightdock.idle.notProviding")) } else if why.ReturnValue { BPL_FDText.T1("freightdock.ship.idleWhy", "why", why.Value) } else { BPL_FDText.T("freightdock.ship.idle") }
        line = if line == "" { idle } else { idle + "\n" + line }
    }
    ShipText.SetText(text(line))
    Dropped(id)
    // Pause for a dock whose ship has work (or is paused); Deliver now only works while loading
    let paused = BPL_FDNet.IsPaused(Dock.activeTradePartnerId)
    PauseBtn.SetVisibility(if provides || paused { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    let away = MapLoad.Voyages.Contains(id)
    let loading = MapLoad.LoadingSince.Contains(id)
    let pending = MapLoad.DepartingSince.Find(id)
    let leaving = pending.ReturnValue
    let canDeliver = !away && loading && !leaving
    Deliver.SetIsEnabled(canDeliver)
    // pending since before 0: Deliver now was pressed (ShipLine)
    DeliverTip.Setup(BPL_FDText.T(if away { "freightdock.deliver.underWay" } else if leaving { (if pending.Value < 0.0 { "freightdock.deliver.departing" } else { "freightdock.deliver.leaving" }) } else { "freightdock.deliver.nothingLoaded" }), SmallFont)
    Deliver.SetToolTip(if canDeliver { none } else { DeliverTip })
    FillNetworks(Dock)
    FillUnload(Dock)
    FillManifest(Dock, id, target != none)
    FillIncoming(Dock, id)
    // the target's sections only while it has one
    let hasTarget = if target == none { ESlateVisibility.Collapsed } else { ESlateVisibility.SelfHitTestInvisible }
    let targetParts: array<Widget> = [DestHead, DestBox, Deliver]
    for w in targetParts {
        w.SetVisibility(hasTarget)
    }
    let i = 0
    for row in SrcRows {
        let b = MapLoad.BuildingById(SrcIds[i]).Building
        if b != none {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            if rb != none {
                row.SetPile(rb.m_stockpile)
            }
        }
        i += 1
    }
}

fn Row(Box: VerticalBox, Caption: string, Where: Vector, CanPan: bool) -> WBP_FDLinkRow {
    let r = create_widget(WBP_FDLinkRow)
    r.Setup(Caption, Where, CanPan, BodyFont)
    Box.AddChildToVerticalBox(r)
    return r
}

// Target, output and input link rows; rebuilt only when the set of buildings changes.
fn BuildRows(Target: WorkDock, Caption: string, DestIds: array<int>, Src: array<int>) {
    TargetBox.ClearChildren()
    DestBox.ClearChildren()
    SrcBox.ClearChildren()
    TargetRows = []
    DestRows = []
    SrcRows = []
    SrcIds = Src
    let nowhere = Vector(X: 0.0, Y: 0.0, Z: 0.0)
    if Target == none {
        TargetBox.SetVisibility(ESlateVisibility.Collapsed)
    } else {
        TargetRows.Add(Row(TargetBox, Caption, Target.GetOwner().K2_GetActorLocation(), true))
        TargetBox.SetVisibility(ESlateVisibility.SelfHitTestInvisible)
    }
    for d in DestIds {
        let b = MapLoad.BuildingById(d).Building
        if b == none {
            DestRows.Add(Row(DestBox, BPL_FDText.T1("freightdock.panel.buildingGone", "id", string(d)), nowhere, false))
        } else {
            let rb = cast(b.GetComponentByClass(ResourceBuilding), ResourceBuilding)
            let empty = if rb == none { false } else { rb.m_forceEmpty }
            DestRows.Add(Row(DestBox, BuildingName(b) + " " + string(d) + (if empty { "  ·  " + BPL_FDText.T("freightdock.panel.keepEmpty") } else { "" }), b.K2_GetActorLocation(), true))
        }
    }
    if DestIds.Length() == 0 {
        DestRows.Add(Row(DestBox, BPL_FDText.T("freightdock.panel.none"), nowhere, false))
    }
    for s in Src {
        let b = MapLoad.BuildingById(s).Building
        if b == none {
            SrcRows.Add(Row(SrcBox, BPL_FDText.T1("freightdock.panel.buildingGone", "id", string(s)), nowhere, false))
        } else {
            SrcRows.Add(Row(SrcBox, BuildingName(b) + " " + string(s), b.K2_GetActorLocation(), true))
        }
    }
    if Src.Length() == 0 {
        Row(SrcBox, BPL_FDText.T("freightdock.panel.none"), nowhere, false)
    }
}

// The ship: with a job, its state (waiting for cargo, loading, leaving, on the way, unloading, returning); its hold
// while at the dock; the one-way trip time. Without a job only the hold (nothing without a ship): Refresh puts why
// it is idle first.
fn ShipLine(Dock: WorkDock, Id: int, HasJob: bool) -> string {
    let s = ""
    if MapLoad.Voyages.Contains(Id) {
        let phase = MapLoad.VoyagePhase[Id]
        s = BPL_FDText.T(if phase == 1 { "freightdock.ship.onTheWay" } else if phase == 2 { "freightdock.ship.unloading" } else { "freightdock.ship.returning" })
    } else {
        let ship = MapLoad.ShipAtDock(Dock).Ship
        if ship == none {
            // without a job the idle reason says it
            s = if HasJob { BPL_FDText.T("freightdock.ship.noShip") } else { "" }
        } else {
            if HasJob {
                let pending = MapLoad.DepartingSince.Find(Id)
                if pending.ReturnValue {
                    // Deliver now marks it pending since long ago (below 0): it sails on the next pass
                    s = BPL_FDText.T(if pending.Value < 0.0 { "freightdock.ship.departing" } else { "freightdock.ship.leaving" }) + "\n"
                } else if !BPL_FDNet.OnDuty(MapLoad, Dock) {
                    s = BPL_FDText.T("freightdock.ship.offDuty") + "\n"
                } else if MapLoad.LoadingSince.Contains(Id) {
                    let waited = Clock(int(GameplayStatics.GetTimeSeconds() - MapLoad.LoadingSince[Id]))
                    let limit = MapLoad.MaxWaitSeconds
                    s = (if limit > 100000.0 { BPL_FDText.T1("freightdock.ship.loading", "time", waited) } else { BPL_FDText.T2("freightdock.ship.loadingOf", "time", waited, "limit", Clock(int(limit))) }) + "\n"
                } else {
                    s = BPL_FDText.T("freightdock.ship.waiting") + "\n"
                }
            }
            let hold = MapLoad.HoldCounts(ship)
            s += BPL_FDText.T2("freightdock.ship.hold", "n", string(hold.Total), "max", string(ship.config.cargoLimit))
        }
    }
    // the trip time only for a job (no other end without one)
    let curve: SplineComponent = none
    if HasJob {
        curve = MapLoad.RouteCurve(Id).Curve
    }
    if curve != none && MapLoad.ShipSpeed > 0.0 {
        s += "\n" + BPL_FDText.T1("freightdock.ship.trip", "time", Clock(int(float(curve.GetSplineLength()) / MapLoad.ShipSpeed)))
    }
    return s
}

// The dock's memberships in ascending network order ("1: provide   3: both", or "Not in a network"), and, while
// editing, the network GUI's table.
fn FillNetworks(Dock: WorkDock) {
    let names: array<string> = ["", BPL_FDText.T("freightdock.role.provide"), BPL_FDText.T("freightdock.role.request"), BPL_FDText.T("freightdock.role.both")]
    let netNames = BPL_FDNet.NetNames(MapLoad)
    let u = BPL_FDNet.Unpack(Dock.activeTradePartnerId)
    let nets: array<int> = []
    let roles: array<int> = []
    let labels: array<string> = []
    let key = ""
    let net = 1
    while net <= BPL_FDNet.MaxNet() {
        let i = 0
        while i < BPL_FDNet.Slots() {
            if u.Nets[i] == net {
                nets.Add(net)
                roles.Add(u.Roles[i])
                let entry = BPL_FDText.T2("freightdock.panel.membership", "net", BPL_FDNet.NetLabel(net, netNames), "role", names[u.Roles[i]])
                labels.Add(entry)
                // the label's text, so a rename or a language change rebuilds the labels
                key += entry + "|"
            }
            i += 1
        }
        net += 1
    }
    // one label per membership, in its network's colour; rebuilt only when the memberships change
    if key != NetEntriesKey {
        NetEntriesKey = key
        NetEntries.ClearChildren()
        NetEntryBoxes = []
        NetEntryNets = []
        NetEntryTips = []
        let k = 0
        while k < nets.Length() {
            let label = construct(TextBlock, self)
            label.SetText(text(labels[k]))
            label.SetColorAndOpacity(SlateColor(SpecifiedColor: BPL_FDNet.NetLinear(nets[k])))
            label.SetFont(BodyFont)
            label.SetAutoWrapText(true)
            let box = construct(Border, self)
            box.SetBrushColor(LinearColor(R: 0.0, G: 0.0, B: 0.0, A: 0.0))
            box.SetPadding(Margin(Left: 0, Top: 0, Right: 8, Bottom: 0))
            box.SetContent(label)
            let tip = create_widget(WBP_FDMembersTip)
            box.SetToolTip(tip)
            NetEntries.AddChildToVerticalBox(box)
            NetEntryBoxes.Add(box)
            NetEntryNets.Add(nets[k])
            NetEntryTips.Add(tip)
            k += 1
        }
    }
    // each label's tooltip: the network's providers (red) and requesters (blue), by name
    let t = 0
    while t < NetEntryTips.Length() {
        let m = BPL_FDNet.Members(MapLoad, NetEntryNets[t])
        let provNames: array<string> = []
        for p in m.Providers {
            provNames.Add(BPL_FDNet.DockName(MapLoad, p))
        }
        let reqNames: array<string> = []
        for r in m.Requesters {
            reqNames.Add(BPL_FDNet.DockName(MapLoad, r))
        }
        NetEntryTips[t].Setup(provNames, reqNames, SmallFont)
        t += 1
    }
    NetSummary.SetText(text(BPL_FDText.T("freightdock.panel.notInNetwork")))
    NetSummary.SetVisibility(if nets.Length() == 0 { ESlateVisibility.SelfHitTestInvisible } else { ESlateVisibility.Collapsed })
    if Editing && NetPanel != none {
        if HaveBrush && HaveFonts {
            NetPanel.SetLook(Bg.Brush, Bg.ColorAndOpacity, TitleFont, HeadFont, BodyFont, SmallFont)
        }
        NetPanel.Show(MapLoad, Dock)
    }
}

// Every frame: what the cursor is over (a NETWORKS entry here, or a part of the network GUI's table) decides the
// arcs and pointers drawn (BPL_FDPairing.Highlight, worked out only when it changes).
fn HoverStep() {
    let net = 0
    let kind = 0
    let good: name = "None"
    if GetVisibility() == ESlateVisibility.Visible {
        let i = 0
        while i < NetEntryBoxes.Length() {
            if NetEntryBoxes[i].IsHovered() {
                net = NetEntryNets[i]
                kind = 1
            }
            i += 1
        }
        if kind == 0 && Editing && NetPanel != none {
            let h = NetPanel.Hover()
            net = h.Net
            kind = h.Kind
            good = h.Good
        }
    }
    if net != HiNet || kind != HiKind || good != HiGood {
        HiNet = net
        HiKind = kind
        HiGood = good
        BPL_FDPairing.Highlight(MapLoad, net, kind, good)
    }
}

// What the target's ship left at this dock (its goods-from-sea store) and haulers haven't picked up yet; the
// section is hidden while the store is empty.
fn FillUnload(Dock: WorkDock) {
    let pile = Dock.m_stockpile_goodsFromSea
    let total = 0
    for res, slot in pile.Slots {
        total += slot.count
    }
    if total > 0 {
        UnloadIcons.SetDataFromStockpile(pile, false, false)
        UnloadBox.SetVisibility(ESlateVisibility.SelfHitTestInvisible)
    } else {
        UnloadBox.SetVisibility(ESlateVisibility.Collapsed)
    }
}

// The goods dropped from the job (MapLoad.JobDropped, "good=units,..."), by their names in the player's language.
fn Dropped(Id: int) {
    let d = MapLoad.JobDropped.Find(Id)
    let parts: array<string> = []
    if d.ReturnValue {
        for entry in KismetStringLibrary.ParseIntoArray(d.Value, ",", true) {
            let kv = KismetStringLibrary.Split(entry, "=", ESearchCase.CaseSensitive, ESearchDir.FromStart)
            let def = ArcoGameInstance.GetResourceDefCopy(self, name(kv.LeftS))
            let word = LocManager.GetWordFromKey(def.stringKey)
            parts.Add(kv.RightS + " " + (if word == "" { kv.LeftS } else { word }))
        }
    }
    DroppedText.SetText(text(BPL_FDText.T1("freightdock.ship.dropped", "goods", KismetStringLibrary.JoinStringArray(parts, ", "))))
    DroppedText.SetVisibility(if parts.Length() > 0 { ESlateVisibility.SelfHitTestInvisible } else { ESlateVisibility.Collapsed })
}

// For a dock that requests: a row per good its output warehouses still want or that is on its way (WBP_FDIncomingRow):
// how much is wanted (less what is unloaded here), how much is coming (jobs to this dock not yet delivered), and
// where from - loading at the provider, or sailing with the arrival time - or why nothing comes (MapLoad.WhyNot).
fn FillIncoming(Dock: WorkDock, Id: int) {
    let u = BPL_FDNet.Unpack(Dock.activeTradePartnerId)
    let requests = false
    for role in u.Roles {
        if (role & BPL_FDNet.Request()) != 0 {
            requests = true
        }
    }
    let wanted: map<name, int> = {}
    let coming: map<name, int> = {}
    let notes: map<name, string> = {}
    if requests {
        for res, deficit in MapLoad.DeficitsFor(Dock).Want.counts {
            let atDock = Dock.m_stockpile_goodsFromSea.Slots.Find(res)
            let open = deficit - (if atDock.ReturnValue { atDock.Value.count } else { 0 })
            if open > 0 {
                wanted[res] = open
            }
        }
        for pid, rid in MapLoad.JobTo {
            if rid == Id {
                let ph = MapLoad.VoyagePhase.Find(pid)
                let sailing = MapLoad.Voyages.Contains(pid) && ph.ReturnValue
                let delivered = sailing && ph.Value >= 2
                if !delivered {
                    let from = BPL_FDNet.DockName(MapLoad, BPL_FDNet.DockIn(MapLoad, pid))
                    let note = BPL_FDText.T1("freightdock.incoming.loading", "dock", from)
                    if sailing {
                        let course = MapLoad.VoyageSpline.Find(pid)
                        let done = MapLoad.VoyageDist.Find(pid)
                        let secs = 0
                        if course.ReturnValue && done.ReturnValue && MapLoad.ShipSpeed > 0.0 {
                            if course.Value != none {
                                secs = int(KismetMathLibrary.FMax(float(course.Value.GetSplineLength()) - done.Value, 0.0) / MapLoad.ShipSpeed)
                            }
                        }
                        note = BPL_FDText.T2("freightdock.incoming.sailing", "dock", from, "time", Clock(secs))
                    }
                    for res, units in BPL_FDNet.Manifest(MapLoad, pid) {
                        let c = coming.Find(res)
                        coming[res] = (if c.ReturnValue { c.Value } else { 0 }) + units
                        let had = notes.Find(res)
                        notes[res] = if had.ReturnValue { had.Value + "; " + note } else { note }
                    }
                }
            }
        }
    }
    let goods: array<name> = []
    for res, n in wanted {
        goods.Add(res)
    }
    for res, n in coming {
        goods.AddUnique(res)
    }
    let k = 0
    for good in goods {
        if k >= IncomingRows.Length() {
            let made = create_widget(WBP_FDIncomingRow)
            IncomingRowsBox.AddChildToVerticalBox(made)
            IncomingRows.Add(made)
        }
        let w = wanted.Find(good)
        let cg = coming.Find(good)
        let inbound = if cg.ReturnValue { cg.Value } else { 0 }
        let why = MapLoad.WhyNot.Find(BPL_FDNet.JobKey(Id, good))
        let n = notes.Find(good)
        let note = if inbound > 0 && n.ReturnValue { n.Value } else if why.ReturnValue { why.Value } else { BPL_FDText.T("freightdock.incoming.waiting") }
        IncomingRows[k].SetVisibility(ESlateVisibility.SelfHitTestInvisible)
        IncomingRows[k].Show(good, if w.ReturnValue { w.Value } else { 0 }, inbound, note, BodyFont, SmallFont)
        k += 1
    }
    let i = k
    while i < IncomingRows.Length() {
        IncomingRows[i].SetVisibility(ESlateVisibility.Collapsed)
        i += 1
    }
    IncomingBox.SetVisibility(if k > 0 { ESlateVisibility.SelfHitTestInvisible } else { ESlateVisibility.Collapsed })
}

// The job's manifest, a row per good (WBP_FDWantRow), in the order goods move: free in this dock's input warehouses,
// still to fetch (the job's amount less what is being carried and aboard), being carried here, aboard, and the job's
// amount. Collapsed without a job.
fn FillManifest(Dock: WorkDock, Id: int, HasJob: bool) {
    let n = 0
    if HasJob {
        let ship = MapLoad.ShipAtDock(Dock).Ship
        let hold: map<name, int> = {}
        if ship != none {
            hold = MapLoad.HoldCounts(ship).Counts
        }
        let free = BPL_FDNet.SourceStock(MapLoad, Dock).Stock
        for res, units in BPL_FDNet.Manifest(MapLoad, Id) {
            let h = hold.Find(res)
            let aboard = if h.ReturnValue { h.Value } else { 0 }
            let slot = Dock.m_inputStockpile.Slots.Find(res)
            let carried = if slot.ReturnValue { slot.Value.reservedSpaceForDropoff } else { 0 }
            let f = free.Find(res)
            let available = if f.ReturnValue { f.Value } else { 0 }
            let reserved = KismetMathLibrary.Max(units - carried - aboard, 0)
            if n >= ManifestRows.Length() {
                let made = create_widget(WBP_FDWantRow)
                ManifestBox.AddChildToVerticalBox(made)
                ManifestRows.Add(made)
            }
            let row = ManifestRows[n]
            row.SetVisibility(ESlateVisibility.SelfHitTestInvisible)
            row.Show(res, available, reserved, carried, aboard, units, BodyFont)
            n += 1
        }
    }
    let i = n
    while i < ManifestRows.Length() {
        ManifestRows[i].SetVisibility(ESlateVisibility.Collapsed)
        i += 1
    }
    let shown = if n > 0 { ESlateVisibility.SelfHitTestInvisible } else { ESlateVisibility.Collapsed }
    ManifestHead.SetVisibility(shown)
    ManifestBox.SetVisibility(shown)
}
