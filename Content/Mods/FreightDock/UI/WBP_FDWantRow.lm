blueprint WBP_FDWantRow : UserWidget at /Game/Mods/FreightDock/UI/WBP_FDWantRow

// One row of the dock GUI's manifest table (WBP_FDPanel.FillManifest): a good's icon and name, then, in the order
// goods move through them: available to load (free in this dock's input warehouses), reserved with no hauler yet
// (still to fetch), on the way here, on the ship, and the job's amount. No header: each cell explains itself on
// hover.

widget Row: HorizontalBox {
    widget IconBox: SizeBox(WidthOverride: 26.0, HeightOverride: 26.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
        widget Icon: Image
    }
    widget NameBox: SizeBox(WidthOverride: 96.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center, Padding: Margin(Left: 6, Top: 0, Right: 0, Bottom: 0)) {
        widget ResName: LocTextBlock(ColorAndOpacity: "#ddd3bcff")
    }
    widget AvailableBox: SizeBox(WidthOverride: 50.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
        widget Available: TextBlock(Text: "0", ColorAndOpacity: "#9c917cff", Justification: ETextJustify.Center)
    }
    widget ReservedBox: SizeBox(WidthOverride: 50.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
        widget Reserved: TextBlock(Text: "0", ColorAndOpacity: "#ddd3bcff", Justification: ETextJustify.Center)
    }
    widget CarriedBox: SizeBox(WidthOverride: 50.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
        widget Carried: TextBlock(Text: "0", ColorAndOpacity: "#ddd3bcff", Justification: ETextJustify.Center)
    }
    widget AboardBox: SizeBox(WidthOverride: 50.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
        widget Aboard: TextBlock(Text: "0", ColorAndOpacity: "#ddd3bcff", Justification: ETextJustify.Center)
    }
    widget RequestedBox: SizeBox(WidthOverride: 50.0) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
        widget Requested: TextBlock(Text: "0", ColorAndOpacity: "#e8c872ff", Justification: ETextJustify.Center)
    }
}

var Tips: array<WBP_FDTip>

// Each cell's tooltip: a WBP_FDTip in the table's font. Made on the first Show and set again on every Show, since
// the panel may not have the window's fonts yet the first time (and the language may change).
fn Tip(Index: int, Cell: Widget, Msg: string, Font: SlateFontInfo) {
    if Tips.Length() <= Index {
        let t = create_widget(WBP_FDTip)
        Cell.SetToolTip(t)
        Tips.Add(t)
    }
    Tips[Index].Setup(Msg, Font)
}

fn Show(Res: name, InAvailable: int, InReserved: int, InCarried: int, InAboard: int, InRequested: int, Font: SlateFontInfo) {
    let def = ArcoGameInstance.GetResourceDefCopy(self, Res)
    Icon.SetBrushFromTexture(def.Icon, false)
    ResName.SetKey(def.stringKey)
    Tip(0, AvailableBox, BPL_FDText.T("freightdock.manifest.available"), Font)
    Tip(1, ReservedBox, BPL_FDText.T("freightdock.manifest.reserved"), Font)
    Tip(2, CarriedBox, BPL_FDText.T("freightdock.manifest.carried"), Font)
    Tip(3, AboardBox, BPL_FDText.T("freightdock.manifest.aboard"), Font)
    Tip(4, RequestedBox, BPL_FDText.T("freightdock.manifest.requested"), Font)
    let cells: array<TextBlock> = [ResName, Available, Reserved, Carried, Aboard, Requested]
    for c in cells {
        c.SetFont(Font)
    }
    Available.SetText(text(string(InAvailable)))
    Reserved.SetText(text(string(InReserved)))
    Carried.SetText(text(string(InCarried)))
    Aboard.SetText(text(string(InAboard)))
    Requested.SetText(text(string(InRequested)))
}
